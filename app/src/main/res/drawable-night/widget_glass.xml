<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_glass_fill" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item android:height="70dp" android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="@color/widget_glass_top" />
            <corners android:topLeftRadius="20dp" android:topRightRadius="20dp" />
        </shape>
    </item>
    <item android:height="70dp" android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="@color/widget_glass_bottom"
                android:startColor="@color/widget_glass_bottom_clear" />
            <corners android:bottomLeftRadius="20dp" android:bottomRightRadius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/widget_glass_border" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>