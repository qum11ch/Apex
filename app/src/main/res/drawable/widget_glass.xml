<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- the ultra-thin outer edge: separates the glass from light wallpapers -->
    <item
        android:bottom="0.4dp"
        android:left="0.4dp"
        android:right="0.4dp"
        android:top="0.4dp">
        <shape android:shape="rectangle">
            <stroke android:width="0.8dp" android:color="#1A0F172A" />
            <corners android:radius="19.6dp" />
        </shape>
    </item>

    <!-- the glass: denser at the bottom so the dark wallpaper does not show through the text -->
    <item
        android:bottom="0.8dp"
        android:left="0.8dp"
        android:right="0.8dp"
        android:top="0.8dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#D6E8EFF8"
                android:startColor="#CCF8FBFF" />
            <corners android:radius="19.2dp" />
        </shape>
    </item>

    <!-- the bright inner edge -->
    <item
        android:bottom="1.55dp"
        android:left="1.55dp"
        android:right="1.55dp"
        android:top="1.55dp">
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="#E6FFFFFF" />
            <corners android:radius="18.45dp" />
        </shape>
    </item>
</layer-list>