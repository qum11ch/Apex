<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#4D8A8A8E"
                android:startColor="#FFFFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:centerColor="#F0EEEEF0"
                android:endColor="#EBE6E6E9"
                android:startColor="#F7F7F7F8" />
            <corners android:radius="18.5dp" />
        </shape>
    </item>
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:top="1.5dp">
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.12"
                android:centerY="0.0"
                android:endColor="#00FFFFFF"
                android:gradientRadius="85%"
                android:startColor="#B3FFFFFF"
                android:type="radial" />
            <corners android:radius="18.5dp" />
        </shape>
    </item>
    <item
        android:bottom="1.5dp"
        android:left="1.5dp"
        android:right="1.5dp"
        android:height="60dp"
        android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#1F000000"
                android:startColor="#00000000" />
            <corners android:bottomLeftRadius="18.5dp" android:bottomRightRadius="18.5dp" />
        </shape>
    </item>
</layer-list>