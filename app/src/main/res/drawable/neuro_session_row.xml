<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape>
                    <solid android:color="@color/neuro_selected" />
                </shape>
            </item>
            <item
                android:width="2dp"
                android:gravity="start"
                android:top="5dp"
                android:bottom="5dp">
                <shape>
                    <solid android:color="@color/neuro_accent"/>
                    <corners android:radius="2dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape>
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>