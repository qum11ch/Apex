<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@+id/account_settings_root"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    tools:context=".registerPageActivity"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="16dp"
        android:id="@+id/header"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/account_settings_header_color">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back_arrow"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:src="@drawable/back_arrow" />

        <TextView
            android:textStyle="bold"
            android:layout_gravity="center"
            android:textAllCaps="true"
            android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/settings"
            android:textColor="@color/white"
            android:textSize="22sp"/>

        <Space
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:layout_alignParentBottom="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="150dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="125dp"
                    android:background="@color/account_settings_header_color"
                    android:id="@+id/changeBackgroundLayout">
                    <ImageView
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        style="@style/ButtonStyle"
                        android:padding="2dp"
                        android:src="@drawable/edit_bg"
                        android:backgroundTint="#DEDEDE"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </RelativeLayout>
                <RelativeLayout
                    android:layout_marginStart="20dp"
                    android:layout_alignParentBottom="true"
                    android:id="@+id/changeAvatarLayout"
                    android:layout_width="110dp"
                    android:layout_height="110dp">
                    <androidx.cardview.widget.CardView
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentStart="true"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp">
                        <com.google.android.material.imageview.ShapeableImageView
                            app:shapeAppearanceOverlay="@style/customRoundedImageView.Avatar"
                            android:layout_gravity="center"
                            android:id="@+id/avatarImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            app:strokeWidth="2dp"
                            app:strokeColor="@color/text_color_thirdly"/>
                        <TextView
                            android:layout_gravity="center"
                            android:background="@android:color/transparent"
                            android:id="@+id/avatarInitial"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textColor="@color/text_color_secondary"
                            android:textSize="38sp"
                            android:textStyle="bold" />
                    </androidx.cardview.widget.CardView>
                    <ImageView
                        style="@style/ButtonStyle"
                        android:padding="2dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/edit"
                        android:backgroundTint="@color/text_color_thirdly"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                        android:id="@+id/changeAvatarButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </RelativeLayout>

            </RelativeLayout>
            <TextView
                android:layout_marginTop="10dp"
                android:layout_marginEnd="20dp"
                android:layout_marginStart="25dp"
                android:id="@+id/usernameMain"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_color_main"
                android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader" />
            <TextView
                android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                android:layout_marginEnd="20dp"
                android:layout_marginStart="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/account_data"
                android:textColor="@color/grey"
                android:textSize="18sp"
                android:textStyle="bold" />
            <androidx.cardview.widget.CardView
                android:layout_marginEnd="20dp"
                android:layout_marginStart="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/account_settings_input_color"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">
                    <androidx.cardview.widget.CardView
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/colorPrimary">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="72dp"
                            android:orientation="horizontal"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:baselineAligned="false"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                tools:ignore="UselessParent">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/loginText"
                                    android:textSize="13sp"
                                    android:textColor="@color/grey" />

                                <TextView
                                    android:textColor="@color/text_color_main"
                                    android:id="@+id/currentLogin"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textSize="16sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/colorPrimary">

                        <LinearLayout
                            android:layout_height="wrap_content"
                            android:minHeight="72dp"
                            android:orientation="horizontal"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:id="@+id/changeUsernameButton"
                            android:layout_width="match_parent"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="0dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/usernameText"
                                    android:textSize="13sp"
                                    android:textColor="@color/grey" />

                                <TextView
                                    android:textColor="@color/text_color_main"
                                    android:id="@+id/username"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textSize="16sp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:scaleType="fitCenter"
                                android:layout_gravity="center_vertical"
                                android:layout_marginStart="5dp"
                                android:layout_marginEnd="8dp"
                                android:src="@drawable/arrow"
                                android:scaleX="-1"
                                android:contentDescription="@string/front_arrow"
                                android:cropToPadding="true"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/colorPrimary">

                        <LinearLayout
                            android:layout_height="wrap_content"
                            android:minHeight="72dp"
                            android:orientation="horizontal"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:id="@+id/changeEmailButton"
                            android:layout_width="match_parent"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="0dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/emailText"
                                    android:textSize="13sp"
                                    android:textColor="@color/grey" />

                                <TextView
                                    android:textColor="@color/text_color_main"
                                    android:id="@+id/currentEmail"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:ellipsize="end"
                                    android:maxLines="1"
                                    android:textSize="16sp" />
                            </LinearLayout>
                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:scaleType="fitCenter"
                                android:layout_gravity="center_vertical"
                                android:contentDescription="@string/front_arrow"
                                android:cropToPadding="true"
                                android:layout_marginStart="5dp"
                                android:src="@drawable/arrow"
                                android:scaleX="-1"
                                android:layout_marginEnd="8dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                    <androidx.cardview.widget.CardView
                        android:background="@color/colorPredicts"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/colorPrimary"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_height="wrap_content"
                            android:minHeight="72dp"
                            android:orientation="horizontal"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:id="@+id/changePasswordButton"
                            android:layout_width="match_parent"
                            android:gravity="center_vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="0dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="@string/passwordText"
                                    android:textSize="13sp"
                                    android:textColor="@color/grey" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:text="••••••••"
                                    android:textColor="@color/text_color_main"
                                    android:textSize="16sp" />
                            </LinearLayout>

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:scaleType="fitCenter"
                                android:layout_gravity="center_vertical"
                                android:contentDescription="@string/front_arrow"
                                android:cropToPadding="true"
                                android:layout_marginStart="5dp"
                                android:src="@drawable/arrow"
                                android:scaleX="-1"
                                android:layout_marginEnd="8dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <Button
                android:minHeight="48dp"
                android:id="@+id/logoutButton"
                android:layout_marginEnd="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="28dp"
                android:textSize="12sp"
                android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                android:text="@string/logout"
                android:textColor="@color/logout_button_color"
                android:textStyle="bold"
                android:elevation="0dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAllCaps="true"
                style="@style/LogoutButtonStyle"/>

            <Button
                android:minHeight="48dp"
                android:layout_marginEnd="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="28dp"
                android:textSize="12sp"
                android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold"
                android:backgroundTint="@color/text_color_thirdly"
                android:elevation="0dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/deleteAccountButton"
                android:text="@string/delete_account"
                android:textAllCaps="true"
                style="@style/ButtonStyle"/>

        </LinearLayout>
    </ScrollView>
</RelativeLayout>