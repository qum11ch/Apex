<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/awardsCollectionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorPrimary">
    <LinearLayout
        android:id="@+id/awardsCollectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/header_color"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/awardsCollectionBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="14dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/back_arrow"
            android:contentDescription="@string/back_arrow" />

        <TextView
            android:id="@+id/raceTitile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/awards_catalogue_title"
            android:textColor="@color/white"
            android:textAllCaps="true"
            android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"
            android:textSize="20sp" />
        <Space
            android:layout_width="48dp"
            android:layout_height="48dp"/>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:id="@+id/awardsCollectionCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="—"
            android:textColor="@color/text_color_main"
            android:textSize="14sp"
            android:textAppearance="@style/TextStyle.Gram.Regular.Simple" />

        <ImageButton
            android:id="@+id/awardsCollectionRefresh"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/refresh"
            android:padding="12dp"
            android:src="@android:drawable/ic_popup_sync"
            app:tint="@color/text_color_main" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:id="@+id/awardsFilterAll"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:padding="8dp"
            android:gravity="center"
            android:text="@string/awards_filter_all"
            android:textSize="13sp"
            android:textColor="@color/text_color_main"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />
        <TextView
            android:id="@+id/awardsFilterEarned"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:padding="8dp"
            android:gravity="center"
            android:text="@string/awards_filter_earned"
            android:textSize="13sp"
            android:textColor="@color/text_color_main"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />
        <TextView
            android:id="@+id/awardsFilterLocked"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:padding="8dp"
            android:gravity="center"
            android:text="@string/awards_filter_locked"
            android:textSize="13sp"
            android:textColor="@color/text_color_main"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>
    <TextView
        android:id="@+id/awardsCollectionState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="@color/grey"
        android:textSize="13sp"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextStyle.Gram.Regular.Simple" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/awardsCollectionList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />
</LinearLayout>
