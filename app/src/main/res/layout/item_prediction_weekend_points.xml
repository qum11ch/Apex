<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:layout_width="match_parent" android:layout_height="wrap_content"
 android:orientation="horizontal" android:gravity="center_vertical"
 android:minHeight="48dp" android:paddingTop="8dp" android:paddingBottom="8dp">
 <TextView android:id="@+id/spwRace" android:layout_width="0dp" android:layout_height="wrap_content"
 android:layout_weight="1" android:layout_marginEnd="8dp" android:textColor="@color/text_color_main" android:textSize="14sp"/>
 <TextView android:id="@+id/spwValueA" android:layout_width="84dp" android:layout_height="wrap_content"
 android:gravity="center" android:textColor="@color/text_color_main" android:textSize="14sp" android:textStyle="bold"/>
 <TextView android:id="@+id/spwValueB" android:layout_width="84dp" android:layout_height="wrap_content"
 android:gravity="center" android:textColor="@color/text_color_main" android:textSize="14sp" android:textStyle="bold"/>
</LinearLayout>