<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lineup_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout
        android:id="@+id/lineup_photo_block"
        style="@style/ItemStylePreds"
        android:layout_width="match_parent"
        android:layout_height="150dp">

        <ImageView
            android:id="@+id/lineup_photo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:adjustViewBounds="true"
            android:contentDescription="@string/first_driver"
            android:maxHeight="150dp"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:id="@+id/lineup_given_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAppearance="@style/TextStyle.GoodTiming.Regular"
        android:textColor="@color/text_color_main"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/lineup_family_name"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:gravity="center"
        android:maxLines="1"
        android:textAppearance="@style/TextStyle.GoodTiming.Bold"
        android:textColor="@color/text_color_main"
        android:textSize="18sp"
        app:autoSizeMaxTextSize="18sp"
        app:autoSizeMinTextSize="10sp"
        app:autoSizeStepGranularity="1sp"
        app:autoSizeTextType="uniform"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>
