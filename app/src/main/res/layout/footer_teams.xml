<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:paddingStart="5dp"
    android:paddingEnd="5dp"
    android:elevation="4dp">

    <LinearLayout
        android:id="@+id/footer"
        style="@style/FooterStyle"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:weightSum="5"
        android:clipToPadding="false">

        <ImageButton
            android:id="@+id/showHomePage"
            style="@style/footerButtonOff"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/home_off" />

        <ImageButton
            android:id="@+id/showDriver"
            style="@style/footerButtonOff"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/drivers_off" />

        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <View
                style="@style/FooterStyle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="3dp"
                android:backgroundTint="#66B0B0B0" />

            <ImageButton
                android:id="@+id/showTeams"
                style="@style/footerButtonOn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/constructor_on" />

        </RelativeLayout>

        <ImageButton
            android:id="@+id/showSchedule"
            style="@style/footerButtonOff"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/schedule_off" />

        <ImageButton
            android:id="@+id/showAccount"
            style="@style/footerButtonOff"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:src="@drawable/account_off" />

    </LinearLayout>

</LinearLayout>