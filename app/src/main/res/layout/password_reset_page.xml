<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reset_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/resetScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <ImageView
                android:id="@+id/lock_image"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/private_logo"
                android:src="@drawable/lock_vector"
                app:tint="@color/text_color_main" />

            <TextView
                android:id="@+id/resetHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/reset_password_header"
                android:textAllCaps="true"
                android:textColor="@color/text_color_main"
                android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader" />

            <TextView
                android:id="@+id/resetInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/reset_password_info"
                android:textColor="@color/text_color_main"
                android:textSize="20sp"
                android:textAppearance="@style/TextStyle.Gram.Regular" />

            <LinearLayout
                android:id="@+id/emailFieldGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/emailLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/emailText"
                    android:textColor="@color/text_color_main"
                    android:textStyle="normal"
                    android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo" />

                <LinearLayout
                    android:id="@+id/emailBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="68dp"
                    android:background="@drawable/bg_input_box"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:src="@drawable/email_icon" />

                    <EditText
                        android:id="@+id/userEmail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="68dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/emeail_hint_full"
                        android:inputType="textEmailAddress"
                        android:imeOptions="actionDone"
                        android:singleLine="true"
                        android:paddingStart="18dp"
                        android:paddingEnd="8dp"
                        android:textCursorDrawable="@null"
                        android:textColorHighlight="@color/text_color_main"
                        android:textColorLink="@color/text_color_main"
                        android:textColor="@color/text_color_main"
                        android:textColorHint="@color/text_color_secondary"
                        android:textSize="18sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/emailError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/red"
                    android:textSize="14sp"
                    android:visibility="gone" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/resetLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <Button
                    android:id="@+id/resetPassword"
                    style="@style/ButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="@string/reset_password_button"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:elevation="0dp" />

                <ProgressBar
                    android:id="@+id/resetProgress"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:visibility="invisible"
                    android:indeterminate="true"
                    android:indeterminateTintMode="src_atop"
                    android:indeterminateTint="@color/red" />

            </FrameLayout>

            <Button
                android:id="@+id/backButton"
                style="@style/ButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:layout_marginTop="12dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:drawableStart="@drawable/back_arrow_black"
                android:drawablePadding="12dp"
                android:text="@string/back"
                android:textAllCaps="true"
                android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                android:textColor="@color/colorPrimary"
                android:textStyle="bold"
                android:backgroundTint="@color/text_color_main"
                android:elevation="0dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</RelativeLayout>