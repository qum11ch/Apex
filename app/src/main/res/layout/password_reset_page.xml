<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".registerPageActivity"
    android:background="@color/colorPrimary"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <ImageView
        app:tint="@color/text_color_main"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        android:layout_above="@id/resetHeader"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:id="@+id/lock_image"
        android:contentDescription="@string/private_logo"
        android:src="@drawable/lock_vector"
        android:layout_centerHorizontal="true"/>
    <TextView
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        android:layout_above="@id/resetInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/resetHeader"
        android:textAllCaps="true"
        android:gravity="center"
        android:text="@string/reset_password_header"
        android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"/>
    <TextView
        android:textColor="@color/text_color_main"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        android:layout_above="@id/emailFieldGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/resetInfo"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:text="@string/reset_password_info"
        android:textSize="20sp"
        android:textAppearance="@style/TextStyle.Gram.Regular"/>
    <LinearLayout
        android:layout_centerVertical="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:id="@+id/emailFieldGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:orientation="vertical">

        <TextView
            android:textStyle="normal"
            android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
            android:id="@+id/emailLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/emailText"
            android:textColor="@color/text_color_main" />

        <LinearLayout
            android:id="@+id/emailBox"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@drawable/bg_input_box"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:src="@drawable/email_icon" />

            <EditText
                android:textCursorDrawable="@null"
                android:textColorHighlight="@color/text_color_main"
                android:textColorLink="@color/text_color_main"
                android:textColor="@color/text_color_main"
                android:id="@+id/userEmail"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/emeail_hint_full"
                android:inputType="textEmailAddress"
                android:singleLine="true"
                android:paddingStart="18dp"
                android:paddingEnd="8dp"
                android:textColorHint="@color/text_color_secondary"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/emailError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/red"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
    <FrameLayout
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        android:layout_above="@id/backButton"
        android:id="@+id/resetLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ProgressBar
            android:backgroundTint="@color/red"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center_horizontal"
            android:visibility="invisible"
            android:id="@+id/resetProgress"
            android:indeterminate="true"
            android:indeterminateTintMode="src_atop"
            android:indeterminateTint="@color/red"/>
        <Button
            android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:elevation="0dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/resetPassword"
            android:text="@string/reset_password_button"
            android:textAllCaps="true"
            style="@style/ButtonStyle"/>
    </FrameLayout>
    <Button
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="20dp"
        android:layout_marginStart="20dp"
        android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
        android:textColor="@color/colorPrimary"
        android:textStyle="bold"
        android:elevation="0dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/backButton"
        android:text="@string/back"
        android:paddingStart="30dp"
        android:paddingEnd="50dp"
        android:drawableStart="@drawable/back_arrow_black"
        app:tint="@color/colorPrimary"
        android:textAllCaps="true"
        android:backgroundTint="@color/text_color_main"
        android:layout_marginBottom="50dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        style="@style/ButtonStyle"/>
</RelativeLayout>