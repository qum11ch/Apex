<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="44dp" android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingTop="8dp" android:paddingBottom="8dp">
    <TextView android:id="@+id/trRace" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="8dp" android:textColor="@color/text_color_main" android:textSize="14sp"/>
    <TextView android:id="@+id/trFinishesA" android:layout_width="84dp" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="@color/text_color_main" android:textSize="14sp" android:textStyle="bold"/>
    <TextView android:id="@+id/trFinishesB" android:layout_width="84dp" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="@color/text_color_main" android:textSize="14sp" android:textStyle="bold"/>
</LinearLayout>