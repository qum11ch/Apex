<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/selectedOptionCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="84dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/bg_prediction_participant"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:visibility="gone">
    <ImageView
        android:id="@+id/selectedOptionImage"
        android:layout_width="100dp"
        android:layout_height="52dp"
        android:layout_marginEnd="12dp"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"
        android:src="@drawable/placeholder" />
    <TextView
        android:id="@+id/selectedOptionName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
        android:textColor="@color/text_color_main"
        android:textSize="17sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/selectedOptionAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
        android:textColor="@color/text_color_secondary"
        android:textSize="14sp"
        android:text="@string/pp_change" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="&#8250;"
        android:textSize="24sp"
        android:textColor="@color/text_color_secondary"
        android:importantForAccessibility="no" />
</LinearLayout>
