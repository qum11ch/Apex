<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    style="@style/BackgroundGradient"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:paddingTop="40dp"
        android:paddingBottom="20dp"
        android:layout_height="wrap_content"
        android:background="@color/red">
        <ImageButton
            android:visibility="gone"
            android:layout_marginTop="2dp"
            android:id='@+id/backButton'
            android:contentDescription="@string/back_arrow"
            android:paddingEnd="30dp"
            android:paddingStart="0dp"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:src="@drawable/back_arrow"
            android:background="@color/red"/>
        <TextView
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:textColor="@color/white"
            android:textAllCaps="true"
            android:text="@string/drivers_header"
            android:id="@+id/teamsHeader"
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"/>
    </RelativeLayout>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:layout_marginTop="95dp">
        <androidx.core.widget.NestedScrollView
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="0dp"
                android:paddingEnd="10dp">
                <androidx.recyclerview.widget.RecyclerView
                    android:nestedScrollingEnabled="false"
                    android:scrollingCache="true"
                    android:animateLayoutChanges="false"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    android:overScrollMode="never"
                    android:clipToPadding = "false"
                    android:paddingTop="10dp"
                    android:paddingBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/recyclerview_currentDrivers"
                    android:visibility="gone"/>
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmer_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:duration="1500">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical">
                        <include layout="@layout/shimmer_driver_standings" />
                        <include layout="@layout/shimmer_driver_standings" />
                        <include layout="@layout/shimmer_driver_standings" />
                        <include layout="@layout/shimmer_driver_standings" />
                        <include layout="@layout/shimmer_driver_standings" />
                        <include layout="@layout/shimmer_driver_standings" />
                        <include layout="@layout/shimmer_driver_standings" />
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>
                <Button
                    android:visibility="gone"
                    android:layout_below="@id/recyclerview_currentDrivers"
                    style="@style/PrevResultsStyle"
                    android:textColor="@color/text_color_main"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:textAppearance="@style/TextStyle.Gram.Bold"
                    android:id="@+id/driversStandings_2025"
                    android:textSize="18sp"
                    android:paddingStart="20dp"
                    android:paddingEnd="5dp"
                    android:textAlignment="textStart"/>
                <View
                    android:visibility="gone"
                    android:layout_below="@id/driversStandings_2025"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="@color/text_color_main"
                    android:id="@+id/driverStndLine"/>
                <Button
                    android:visibility="gone"
                    android:layout_marginBottom="90dp"
                    android:layout_below="@id/driverStndLine"
                    style="@style/PrevResultsStyleButtom"
                    android:textColor="@color/text_color_main"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:textAppearance="@style/TextStyle.Gram.Bold"
                    android:id="@+id/driversStandings_2024"
                    android:textSize="18sp"
                    android:paddingStart="20dp"
                    android:paddingEnd="5dp"
                    android:textAlignment="textStart" />
            </RelativeLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:weightSum="5"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingBottom="20dp">

        <View android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:clickable="true" android:focusable="true" />
        <View android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:clickable="true" android:focusable="true" />
        <View android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:clickable="true" android:focusable="true" />
        <View android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:clickable="true" android:focusable="true" />
        <View android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:clickable="true" android:focusable="true" />

    </LinearLayout>

    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="20dp"
        layout="@layout/footer_drivers"/>
</androidx.coordinatorlayout.widget.CoordinatorLayout>