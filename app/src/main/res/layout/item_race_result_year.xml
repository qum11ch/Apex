<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/row_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="18dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minWidth="64dp"
            android:textColor="@color/text_color_main"
            android:textSize="22sp"
            android:textAppearance="@style/TextStyle.Audiowide.ForDays" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:paddingEnd="4dp"
                    android:paddingStart="0dp"
                    android:text="@string/one"
                    android:textColor="@color/round_color"
                    android:textSize="12sp"
                    android:textAppearance="@style/TextStyle.Audiowide.ForDays" />
                <TextView
                    android:id="@+id/row_first"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textSize="15sp"
                    android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForCodes" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:paddingEnd="4dp"
                    android:paddingStart="0dp"
                    android:text="@string/two"
                    android:textColor="@color/round_color"
                    android:textSize="12sp"
                    android:textAppearance="@style/TextStyle.Audiowide.ForDays" />
                <TextView
                    android:id="@+id/row_second"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textSize="15sp"
                    android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForCodes" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:paddingEnd="4dp"
                    android:paddingStart="0dp"
                    android:text="@string/three"
                    android:textColor="@color/round_color"
                    android:textSize="12sp"
                    android:textAppearance="@style/TextStyle.Audiowide.ForDays" />
                <TextView
                    android:id="@+id/row_third"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textAllCaps="true"
                    android:textSize="15sp"
                    android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForCodes" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_chevron_right_small"
            app:tint="@color/text_color_secondary" />

    </LinearLayout>

    <View
        android:id="@+id/row_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:background="@color/separator_header" />

</LinearLayout>
