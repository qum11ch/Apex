<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".concludedRaceFragment">

    <com.example.f1app.LockableNestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/schedule_page_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="80dp">

            <RelativeLayout
                style="@style/ScheduleEmptyLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp">

                <RelativeLayout
                    android:id="@+id/emptyConcludedRace_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/stripedImage"
                        style="@style/StripedLinesWhite"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:layout_marginTop="10dp"
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerCircle" />

                    <TextView
                        android:id="@+id/header_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:text="@string/empty_race_list_header"
                        android:textColor="@color/text_color_schedule"
                        android:textSize="28sp"
                        android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/header_text"
                        android:layout_marginStart="10dp"
                        android:layout_marginTop="9dp"
                        android:layout_marginEnd="16dp"
                        android:text="@string/empty_race_list_concluded"
                        android:textColor="@color/text_color_schedule"
                        android:textStyle="normal"
                        android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo" />

                </RelativeLayout>

                <Button
                    android:id="@+id/seasonResults_2025"
                    style="@style/FlatButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:layout_below="@id/emptyConcludedRace_layout"
                    android:layout_marginBottom="2dp"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="@color/text_color_schedule"
                    android:textColor="@color/schedule_color_second"
                    android:textSize="18sp"
                    android:textAlignment="textStart"
                    android:paddingStart="20dp"
                    android:paddingEnd="5dp"
                    android:textAppearance="@style/TextStyle.Gram.Bold" />

                <Button
                    android:id="@+id/seasonResults_2024"
                    style="@style/EmptyButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:layout_below="@id/seasonResults_2025"
                    android:layout_marginBottom="10dp"
                    android:layout_marginEnd="10dp"
                    android:backgroundTint="@color/text_color_schedule"
                    android:textColor="@color/schedule_color_second"
                    android:textSize="18sp"
                    android:textAlignment="textStart"
                    android:paddingStart="20dp"
                    android:paddingEnd="5dp"
                    android:textAppearance="@style/TextStyle.Gram.Bold" />

            </RelativeLayout>

        </LinearLayout>

    </com.example.f1app.LockableNestedScrollView>

</FrameLayout>