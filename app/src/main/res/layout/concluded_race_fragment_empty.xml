<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    android:background="@android:color/transparent"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".concludedRaceFragment"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.example.f1app.LockableNestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:scrollbars="none">
        <RelativeLayout
            style="@style/ScheduleEmptyLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp">
            <RelativeLayout
                android:orientation="vertical"
                android:id="@+id/emptyConcludedRace_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="0dp"
                android:layout_marginEnd="10dp">
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_marginTop="10dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerCircle"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    style="@style/StripedLinesWhite"
                    android:id="@+id/stripedImage"/>
                <TextView
                    android:id="@+id/header_text"
                    android:layout_marginTop="20dp"
                    android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                    android:textColor="@color/text_color_schedule"
                    android:layout_marginStart="10dp"
                    android:textSize="28sp"
                    android:layout_marginEnd="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/empty_race_list_header"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/header_text"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="9dp"
                    android:layout_marginEnd="100dp"
                    android:text="@string/empty_race_list_concluded"
                    android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                    android:textColor="@color/text_color_schedule"
                    android:textStyle="normal" />
            </RelativeLayout>
            <Button
                android:layout_marginBottom="2dp"
                android:layout_below="@id/emptyConcludedRace_layout"
                android:backgroundTint="@color/text_color_schedule"
                android:textSize="18sp"
                style="@style/FlatButtonStyle"
                android:textAlignment="textStart"
                android:paddingStart="20dp"
                android:paddingEnd="5dp"
                android:textColor="@color/schedule_color_second"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:textAppearance="@style/TextStyle.Gram.Bold"
                android:id="@+id/seasonResults_2025"
                android:layout_marginEnd="10dp"/>
            <Button
                android:layout_marginBottom="10dp"
                android:layout_below="@id/seasonResults_2025"
                style="@style/EmptyButton"
                android:backgroundTint="@color/text_color_schedule"
                android:textSize="18sp"
                android:textAlignment="textStart"
                android:paddingStart="20dp"
                android:paddingEnd="5dp"
                android:textColor="@color/schedule_color_second"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:textAppearance="@style/TextStyle.Gram.Bold"
                android:id="@+id/seasonResults_2024"
                android:layout_marginEnd="10dp"/>
        </RelativeLayout>
    </com.example.f1app.LockableNestedScrollView>

</FrameLayout>
