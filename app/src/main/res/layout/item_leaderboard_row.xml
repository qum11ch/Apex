<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <LinearLayout
        android:background="@color/colorPrimary"
        android:id="@+id/lbRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:minHeight="72dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/lbRank"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:layout_width="40dp"
            android:gravity="start|center_vertical"
            android:textColor="@color/text_color_main"
            android:textSize="16sp"/>

        <androidx.cardview.widget.CardView
            android:layout_marginStart="10dp"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardCornerRadius="5dp"
            app:cardElevation="0dp">
            <com.google.android.material.imageview.ShapeableImageView
                app:shapeAppearanceOverlay="@style/customRoundedImageView.lbAvatar"
                android:layout_gravity="center"
                android:id="@+id/lbAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:strokeWidth="1dp"
                app:strokeColor="@color/text_color_thirdly"/>
            <TextView
                android:layout_gravity="center"
                android:background="@android:color/transparent"
                android:id="@+id/lbAvatarInitial"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/text_color_secondary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_marginStart="10dp"
            android:id="@+id/lbName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_color_main"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lbPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_color_main"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:alpha="0.6"
                android:text="@string/points_text"
                android:textColor="@color/text_color_main"
                android:textSize="11sp" />

        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@color/stroke_option_color"
        android:alpha="1"/>
</LinearLayout>