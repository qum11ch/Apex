<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/user_predictions_root"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    tools:context=".userPredictionsActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:paddingTop="16dp"
            android:gravity="center_vertical"
            android:id="@+id/header"
            android:orientation="horizontal"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/header_color">

            <ImageButton
                android:visibility="visible"
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/back_arrow"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:src="@drawable/back_arrow" />

            <TextView
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textStyle="bold"
                android:id="@+id/usersPredictionHeader"
                android:text="@string/user_predictions_header"
                android:layout_gravity="center"
                android:textAllCaps="true"
                android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="22sp"/>

            <ImageButton
                android:id="@+id/predictionRulesButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/neuro_info"
                android:contentDescription="@string/pred_rules_button"
                app:tint="@color/white" />
        </LinearLayout>
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:layout_height="0dp"
            android:layout_weight="1"
            android:id="@+id/swipe_layout"
            android:layout_width="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/userPredictionsScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:paddingBottom="24dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/pageContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/userStatsLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:id="@+id/userPredictionStatsLayout"
                            style="@style/PredictionsLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:layout_marginEnd="15dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/statsHeader"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_marginTop="15dp"
                                android:layout_marginEnd="20dp"
                                android:gravity="start"
                                android:text="@string/user_predictions_stats_text"
                                android:textAllCaps="true"
                                android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader" />

                            <!-- Главные числа -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_marginTop="20dp"
                                android:layout_marginEnd="20dp"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/predictionsCountText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextStyle.Audiowide.ForCountdown"
                                        android:textColor="@color/text_color_main"
                                        android:textSize="28sp" />

                                    <TextView
                                        android:id="@+id/predictionsCount_info"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="Прогнозов"
                                        android:textAppearance="@style/TextStyle.Gram.Regular.Secondary"
                                        android:textColor="@color/text_color_main"
                                        android:textSize="13sp"
                                        android:textStyle="normal" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/correctPredictionsText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextStyle.Audiowide.ForCountdown"
                                        android:textColor="@color/text_color_main"
                                        android:textSize="28sp" />

                                    <TextView
                                        android:id="@+id/correctPredictions_info"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="Угадано"
                                        android:textAppearance="@style/TextStyle.Gram.Regular.Secondary"
                                        android:textColor="@color/text_color_main"
                                        android:textSize="13sp"
                                        android:textStyle="normal" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/totalPointsText"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textAppearance="@style/TextStyle.Audiowide.ForCountdown"
                                        android:textColor="@color/text_color_main"
                                        android:textSize="28sp" />

                                    <TextView
                                        android:id="@+id/totalPoints_info"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:text="Очков"
                                        android:textAppearance="@style/TextStyle.Gram.Regular.Secondary"
                                        android:textColor="@color/text_color_main"
                                        android:textSize="13sp"
                                        android:textStyle="normal" />
                                </LinearLayout>
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginTop="20dp"
                                android:layout_marginEnd="20dp"
                                android:alpha="0.12"
                                android:background="@color/text_color_main" />

                            <!-- Позиция в сезоне -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="20dp"
                                android:gravity="center_vertical"
                                android:minHeight="56dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/seasonRank_info"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="12dp"
                                    android:textAppearance="@style/TextStyle.Gram.Regular.Secondary"
                                    android:textColor="@color/text_color_main"
                                    android:textStyle="normal" />

                                <TextView
                                    android:id="@+id/seasonRank"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextStyle.Audiowide.ForCountdown"
                                    android:textColor="@color/text_color_main"
                                    android:textSize="24sp" />
                            </LinearLayout>

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="1dp"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="20dp"
                                android:alpha="0.12"
                                android:background="@color/text_color_main" />

                            <!-- Общая позиция -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_marginEnd="20dp"
                                android:gravity="center_vertical"
                                android:minHeight="56dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/globalRank_info"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="12dp"
                                    android:textAppearance="@style/TextStyle.Gram.Regular.Secondary"
                                    android:textColor="@color/text_color_main"
                                    android:textStyle="normal" />

                                <TextView
                                    android:id="@+id/globalRank"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="@style/TextStyle.Audiowide.ForCountdown"
                                    android:textColor="@color/text_color_main"
                                    android:textSize="24sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/chartContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_marginTop="8dp"
                                android:layout_marginEnd="20dp"
                                android:layout_marginBottom="20dp"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <com.github.mikephil.charting.charts.PieChart
                                    android:id="@+id/predictionResultsChart"
                                    android:layout_width="match_parent"
                                    android:layout_height="170dp" />

                                <LinearLayout
                                    android:id="@+id/chartLegend"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center_horizontal"
                                    android:orientation="vertical" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/predsHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="@string/user_predictions_preds_rv_text"
                        android:textAlignment="viewStart"
                        android:textAllCaps="true"
                        android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                        android:textColor="@color/text_color_main"
                        android:textSize="20sp" />
                    <FrameLayout
                        android:layout_marginTop="10dp"
                        android:id="@+id/predictionsLoadingContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <TextView
                            android:id="@+id/userPredictionsEmptyText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/user_predictions_stats_empty"
                            android:textColor="@color/text_color_main"
                            android:visibility="gone"
                            android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                            android:textStyle="normal"/>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/userPredictionsRecyclerView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:overScrollMode="never"
                            android:paddingBottom="10dp"
                            android:scrollingCache="true"
                            android:visibility="gone"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/shimmer_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="visible"
                            app:duration="1500">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <include layout="@layout/shimmer_user_prediction" />

                                <include layout="@layout/shimmer_user_prediction" />

                            </LinearLayout>

                        </com.facebook.shimmer.ShimmerFrameLayout>

                    </FrameLayout>

                </LinearLayout>

            </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>