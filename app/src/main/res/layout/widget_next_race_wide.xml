<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/race_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Qatar Grand Prix"
            android:textColor="@color/hero_text"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/live_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/widget_live"
            android:textColor="@color/hero_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/round_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:text="Round 22/23"
            android:textColor="@color/hero_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Lusail, Qatar · 57 laps · 5.419 km"
        android:textColor="@color/hero_text_secondary"
        android:textSize="11sp"
        tools:ignore="HardcodedText" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/session_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Practice 3 · Sat, 14:30"
                android:textColor="@color/hero_text_secondary"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <Chronometer
                    android:id="@+id/countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hero_text"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <Chronometer
                    android:id="@+id/countdown_live"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hero_accent"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/countdown_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="in 1 d 4 h"
                    android:textColor="@color/hero_text"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/weather_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/weather_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="5dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_weather_clear" />

            <TextView
                android:id="@+id/weather_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="23°, 0%"
                android:textColor="@color/hero_text"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/timeline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/col_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:orientation="vertical">
            <ImageView android:id="@+id/bar_1" android:layout_width="match_parent" android:layout_height="4dp" android:background="@drawable/widget_seg_future" android:contentDescription="@null" />
            <TextView android:id="@+id/lbl_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:text="FP1" android:textColor="@color/hero_text" android:textSize="10sp" android:textStyle="bold" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/tm_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="Fri 16:30" android:textColor="@color/hero_text_secondary" android:textSize="10sp" tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout android:id="@+id/col_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:orientation="vertical">
            <ImageView android:id="@+id/bar_2" android:layout_width="match_parent" android:layout_height="4dp" android:background="@drawable/widget_seg_future" android:contentDescription="@null" />
            <TextView android:id="@+id/lbl_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:text="FP2" android:textColor="@color/hero_text" android:textSize="10sp" android:textStyle="bold" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/tm_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="Fri 20:00" android:textColor="@color/hero_text_secondary" android:textSize="10sp" tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout android:id="@+id/col_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:orientation="vertical">
            <ImageView android:id="@+id/bar_3" android:layout_width="match_parent" android:layout_height="4dp" android:background="@drawable/widget_seg_future" android:contentDescription="@null" />
            <TextView android:id="@+id/lbl_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:text="FP3" android:textColor="@color/hero_text" android:textSize="10sp" android:textStyle="bold" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/tm_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="Sat 17:30" android:textColor="@color/hero_text_secondary" android:textSize="10sp" tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout android:id="@+id/col_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:orientation="vertical">
            <ImageView android:id="@+id/bar_4" android:layout_width="match_parent" android:layout_height="4dp" android:background="@drawable/widget_seg_future" android:contentDescription="@null" />
            <TextView android:id="@+id/lbl_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:text="Q" android:textColor="@color/hero_text" android:textSize="10sp" android:textStyle="bold" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/tm_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="Sat 21:00" android:textColor="@color/hero_text_secondary" android:textSize="10sp" tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout android:id="@+id/col_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="4dp" android:layout_weight="1" android:orientation="vertical">
            <ImageView android:id="@+id/bar_5" android:layout_width="match_parent" android:layout_height="4dp" android:background="@drawable/widget_seg_future" android:contentDescription="@null" />
            <TextView android:id="@+id/lbl_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:text="Race" android:textColor="@color/hero_text" android:textSize="10sp" android:textStyle="bold" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/tm_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:text="Sun 19:00" android:textColor="@color/hero_text_secondary" android:textSize="10sp" tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout android:id="@+id/col_6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:visibility="gone">
            <ImageView android:id="@+id/bar_6" android:layout_width="match_parent" android:layout_height="4dp" android:background="@drawable/widget_seg_future" android:contentDescription="@null" />
            <TextView android:id="@+id/lbl_6" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:textColor="@color/hero_text" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/tm_6" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/hero_text_secondary" android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/leader_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Leader ANT · 402 pts (+98)"
            android:textColor="@color/hero_text"
            android:textSize="11sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/record_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="Record 2:02.384"
            android:textColor="@color/hero_text_secondary"
            android:textSize="11sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</LinearLayout>