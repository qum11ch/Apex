<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_hero_card"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dates"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="27-29 Nov"
            android:textAllCaps="true"
            android:textAppearance="@style/TextStyle.Audiowide.ForPTS"
            android:textColor="@color/hero_text_secondary"
            android:textSize="12sp"
            tools:ignore="HardcodedText" />

        <LinearLayout
            android:id="@+id/live_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_live_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/live_dot"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/live_badge"
                android:textAllCaps="true"
                android:textAppearance="@style/TextStyle.Audiowide.ForPTS"
                android:textColor="@color/hero_accent"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/round_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_round_pill"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="22"
            android:textAppearance="@style/TextStyle.Audiowide.ForPTS"
            android:textColor="@color/hero_accent"
            android:textSize="12sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <TextView
        android:id="@+id/headline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:maxLines="2"
        android:text="Lusail, Qatar"
        android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
        android:textColor="@color/hero_text"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/race_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="1"
        android:text="Qatar Grand Prix 2026"
        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
        android:textColor="@color/hero_text_secondary"
        android:textSize="14sp"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/circuit_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Losail International Circuit"
        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
        android:textColor="@color/hero_text_secondary"
        android:textSize="12sp"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/countdown_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Starts in: Practice 3"
        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
        android:textColor="@color/hero_text"
        android:textSize="14sp"
        tools:ignore="HardcodedText" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <Chronometer
                android:id="@+id/countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textAppearance="@style/TextStyle.Audiowide.ForDays"
                android:textColor="@color/hero_text"
                android:textSize="38sp" />

            <Chronometer
                android:id="@+id/countdown_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textAppearance="@style/TextStyle.Audiowide.ForDays"
                android:textColor="@color/hero_accent"
                android:textSize="38sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/countdown_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="3 d 4 h"
                android:textAppearance="@style/TextStyle.Audiowide.ForDays"
                android:textColor="@color/hero_text"
                android:textSize="32sp"
                android:visibility="gone"
                tools:ignore="HardcodedText" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/weather_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/weather_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="6dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_weather_clear" />

            <TextView
                android:id="@+id/weather_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="23°, 0%"
                android:textColor="@color/hero_text"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/timeline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/col_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/widget_chip" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/lbl_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="FP1" android:textAllCaps="true" android:textColor="@color/hero_text" android:textSize="10sp" android:textStyle="bold" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/dy_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="Fri" android:textAllCaps="true" android:textColor="@color/hero_text_secondary" android:textSize="11sp" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/tm_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="16:30" android:textColor="@color/hero_text" android:textSize="14sp" android:textStyle="bold" tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout android:id="@+id/col_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/widget_chip" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/lbl_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="FP2" android:textAllCaps="true" android:textColor="@color/hero_text" android:textSize="10sp" android:textStyle="bold" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/dy_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="Fri" android:textAllCaps="true" android:textColor="@color/hero_text_secondary" android:textSize="11sp" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/tm_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="20:00" android:textColor="@color/hero_text" android:textSize="14sp" android:textStyle="bold" tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout android:id="@+id/col_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/widget_chip" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/lbl_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="FP3" android:textAllCaps="true" android:textColor="@color/hero_text" android:textSize="10sp" android:textStyle="bold" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/dy_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="Sat" android:textAllCaps="true" android:textColor="@color/hero_text_secondary" android:textSize="11sp" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/tm_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="17:30" android:textColor="@color/hero_text" android:textSize="14sp" android:textStyle="bold" tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout android:id="@+id/col_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/widget_chip" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/lbl_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="Q" android:textAllCaps="true" android:textColor="@color/hero_text" android:textSize="10sp" android:textStyle="bold" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/dy_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="Sat" android:textAllCaps="true" android:textColor="@color/hero_text_secondary" android:textSize="11sp" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/tm_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="21:00" android:textColor="@color/hero_text" android:textSize="14sp" android:textStyle="bold" tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout android:id="@+id/col_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="6dp" android:layout_weight="1" android:background="@drawable/widget_chip" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="8dp">
            <TextView android:id="@+id/lbl_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:text="Race" android:textAllCaps="true" android:textColor="@color/hero_text" android:textSize="10sp" android:textStyle="bold" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/dy_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="Sun" android:textAllCaps="true" android:textColor="@color/hero_text_secondary" android:textSize="11sp" tools:ignore="HardcodedText" />
            <TextView android:id="@+id/tm_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:text="19:00" android:textColor="@color/hero_text" android:textSize="14sp" android:textStyle="bold" tools:ignore="HardcodedText" />
        </LinearLayout>

        <LinearLayout android:id="@+id/col_6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/widget_chip" android:gravity="center_horizontal" android:orientation="vertical" android:paddingTop="8dp" android:paddingBottom="8dp" android:visibility="gone">
            <TextView android:id="@+id/lbl_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:textAllCaps="true" android:textColor="@color/hero_text" android:textSize="10sp" android:textStyle="bold" />
            <TextView android:id="@+id/dy_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:textAllCaps="true" android:textColor="@color/hero_text_secondary" android:textSize="11sp" />
            <TextView android:id="@+id/tm_6" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:maxLines="1" android:textColor="@color/hero_text" android:textSize="14sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/leader_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Leader ANT, 402 pts (+98)"
            android:textColor="@color/hero_text"
            android:textSize="12sp"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/record_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:text="Record 2:02.384"
            android:textColor="@color/hero_text_secondary"
            android:textSize="12sp"
            tools:ignore="HardcodedText" />
    </LinearLayout>
</LinearLayout>