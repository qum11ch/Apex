<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="8dp"
    app:cardBackgroundColor="@color/account_settings_input_color"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/grey"
    android:clickable="true"
    android:focusable="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="12dp">

        <FrameLayout
            android:id="@+id/image_frame"
            android:background="@drawable/bg_picker_photo"
            android:backgroundTint="@color/colorPrimary"
            android:layout_width="match_parent"
            android:layout_height="230dp">
            <ImageView
                android:id="@+id/itemImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/favorite_image"
                android:scaleType="fitCenter" />
            <TextView
                android:textStyle="normal"
                android:textSize="48sp"
                android:textColor="@color/grey"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                android:id="@+id/itemPlus"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="+"
                android:visibility="gone" />
        </FrameLayout>
        <TextView
            android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForNames"
            android:id="@+id/itemDriverName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/itemFamilyName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"/>
        <TextView
            android:gravity="center"
            android:textAlignment="center"
            android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
            android:id="@+id/itemTeamName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <TextView
            android:textColor="@color/grey"
            android:textSize="14sp"
            android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
            android:id="@+id/itemSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>