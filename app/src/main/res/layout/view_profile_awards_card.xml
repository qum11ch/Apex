<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/account_settings_input_color"
    app:cardCornerRadius="18dp" app:cardElevation="0dp" app:cardUseCompatPadding="false">
    <LinearLayout android:id="@+id/profileAwardsBody" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="@string/profile_awards_title" android:textColor="@color/text_color_main" android:textSize="16sp"
                android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader" />
            <TextView android:id="@+id/profileAwardsCount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="10dp" android:paddingEnd="10dp" android:text="—" android:textSize="15sp"
                android:textColor="@color/text_color_main" android:textAppearance="@style/TextStyle.Gram.Regular.Simple" />
            <TextView android:id="@+id/profileAwardsRefresh" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="48dp" android:minHeight="48dp" android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp"
                android:text="@string/profile_awards_refresh" android:textSize="12sp" android:textColor="@color/text_color_main"
                android:background="?attr/selectableItemBackgroundBorderless" android:focusable="true" android:clickable="true"
                android:textAppearance="@style/TextStyle.Gram.Regular.Simple" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/profile_awards_subtitle" android:textColor="@color/grey" android:textSize="13sp"
            android:textAppearance="@style/TextStyle.Gram.Regular.Simple" android:layout_marginBottom="12dp" />
        <com.facebook.shimmer.ShimmerFrameLayout android:id="@+id/profileAwardsUpdating"
            android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginBottom="8dp"
            android:visibility="gone" app:shimmer_auto_start="false" app:shimmer_duration="1200">
            <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/stroke_option_color" />
        </com.facebook.shimmer.ShimmerFrameLayout>
        <com.facebook.shimmer.ShimmerFrameLayout android:id="@+id/profileAwardsShimmer"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" app:shimmer_auto_start="false" app:shimmer_duration="1200">
            <GridLayout android:id="@+id/profileAwardsSkeleton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:columnCount="3" android:alignmentMode="alignMargins" />
        </com.facebook.shimmer.ShimmerFrameLayout>
        <GridLayout android:id="@+id/profileAwardsGrid" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:columnCount="3" android:alignmentMode="alignMargins" android:visibility="gone" />
        <TextView android:id="@+id/profileAwardsEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="104dp" android:gravity="center" android:padding="16dp" android:visibility="gone"
            android:text="@string/profile_awards_empty" android:textColor="@color/grey" android:textSize="14sp"
            android:textAppearance="@style/TextStyle.Gram.Regular.Simple" />
        <TextView android:id="@+id/profileAwardsMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="10dp" android:paddingBottom="6dp" android:visibility="gone" android:textColor="@color/text_color_main"
            android:textSize="13sp" android:accessibilityLiveRegion="polite" android:textAppearance="@style/TextStyle.Gram.Regular.Simple" />
        <TextView android:id="@+id/profileAwardsExpand" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:layout_marginTop="8dp" android:gravity="center" android:visibility="gone"
            android:background="?attr/selectableItemBackground" android:textColor="@color/text_color_main" android:textSize="13sp"
            android:clickable="true" android:focusable="true" android:textAppearance="@style/TextStyle.Gram.Regular.Simple" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
