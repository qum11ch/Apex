<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    tools:context=".registerPageActivity"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:paddingTop="40dp"
        android:paddingBottom="20dp"
        android:layout_height="wrap_content"
        android:background="@color/red">
        <ImageButton
            android:layout_marginTop="2dp"
            android:id='@+id/backButton'
            android:contentDescription="@string/back_arrow"
            android:paddingEnd="30dp"
            android:paddingStart="0dp"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:src="@drawable/back_arrow"
            android:background="@color/red"/>
        <TextView
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:textColor="@color/white"
            android:textAllCaps="true"
            android:id="@+id/raceHeader"
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"/>
    </RelativeLayout>
    <ScrollView
        android:layout_below="@id/header"
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_marginTop="100dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/eventName"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                android:textColor="@color/text_color_main"/>
            <TextView
                android:layout_below="@id/eventName"
                android:id="@+id/prediction_title"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader" />
            <TextView
                android:textColor="@color/text_color_main"
                android:paddingStart="5dp"
                android:paddingEnd="0dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="30dp"
                android:text="Выберите вариант ответа"
                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                app:np_textColor="@color/text_color_main"
                android:layout_below="@id/prediction_title"
                android:id="@+id/choicePrediction_hint"/>

            <com.shawnlin.numberpicker.NumberPicker
                android:id="@+id/answer_picker"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/choicePrediction_hint"
                android:layout_centerInParent="true"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:np_dividerColor="@android:color/transparent"
                app:np_dividerType="underline"
                app:np_itemSpacing="50dp"
                app:np_orientation="horizontal"
                app:np_selectedTextColor="@color/text_color_main"
                app:np_textColor="@color/text_color_main"
                app:np_selectedTextSize="20sp"
                app:np_textSize="14sp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/answer_picker"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:gravity="center"
                android:textColor="@color/text_color_main"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/savedAnswerText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/statusText"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:textColor="@color/text_color_main"
                android:textSize="15sp"
                android:visibility="gone" />

            <FrameLayout
                android:layout_below="@id/savedAnswerText"
                android:layout_marginTop="10dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:id="@+id/saveLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ProgressBar
                    android:backgroundTint="@color/red"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center_horizontal"
                    android:visibility="invisible"
                    android:id="@+id/saveProgress"
                    android:indeterminate="true"
                    android:indeterminateTintMode="src_atop"
                    android:indeterminateTint="@color/red"/>
                <Button
                    android:textSize="16sp"
                    android:enabled="true"
                    android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:elevation="0dp"
                    android:id="@+id/saveButton"
                    android:text="@string/save_button_text"
                    android:textAllCaps="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/ButtonStyle"/>
            </FrameLayout>
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>