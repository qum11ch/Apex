<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/teams_standings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        android:background="@color/header_color_gradient">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back_arrow"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:src="@drawable/back_arrow" />

        <TextView
            android:id="@+id/teamsHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:gravity="center"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <Space
            android:layout_width="48dp"
            android:layout_height="48dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        style="@style/BackgroundGradient">
        <!-- Season buttons: same item_season_toggle the driver and team pages use -->
        <HorizontalScrollView
            android:id="@+id/seasonScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="5dp"
            android:paddingTop="10dp"
            android:paddingEnd="5dp"
            android:paddingBottom="6dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/seasonButtonsLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_layout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:ignore="NestedWeights">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="0dp"
                android:paddingEnd="10dp">
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerview_currentTeams"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:clipToPadding="false"
                    android:paddingTop="10dp"
                    android:paddingBottom="16dp"
                    android:overScrollMode="never"
                    android:scrollbars="none" />
                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmer_layout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingTop="10dp"
                    android:visibility="visible"
                    app:duration="1500">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <include layout="@layout/shimmer_team_standings" />
                        <include layout="@layout/shimmer_team_standings" />
                        <include layout="@layout/shimmer_team_standings" />
                        <include layout="@layout/shimmer_team_standings" />
                        <include layout="@layout/shimmer_team_standings" />
                        <include layout="@layout/shimmer_team_standings" />
                        <include layout="@layout/shimmer_team_standings" />
                    </LinearLayout>
                </com.facebook.shimmer.ShimmerFrameLayout>
                <LinearLayout
                    android:id="@+id/state_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="48dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone"
                    android:layout_gravity="top|center_horizontal">
                    <TextView
                        android:id="@+id/state_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="@style/TextStyle.ShareTechCYR.ForInfo"
                        android:textColor="@color/text_color_main"
                        android:textSize="16sp" />
                    <Button
                        android:id="@+id/state_retry"
                        style="@style/ButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:minWidth="160dp"
                        android:text="@string/ps_retry" />
                </LinearLayout>
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>
</LinearLayout>
