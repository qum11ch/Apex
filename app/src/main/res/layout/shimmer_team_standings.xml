<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/colorPrimary"
            style="@style/ItemStyleAlt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="5">
            <TextView
                android:layout_marginTop="5dp"
                android:layout_marginBottom="10dp"
                android:layout_marginEnd="10dp"
                style="@style/ShimmerStyle"
                android:paddingStart="5dp"
                android:paddingEnd="0dp"
                android:layout_weight="0.5"
                android:id="@+id/team_placement"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp" />
            <RelativeLayout
                android:id="@+id/team_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">
                <TextView
                    style="@style/ShimmerStyle"
                    android:id="@+id/teamName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="2dp"/>
                <TextView
                    style="@style/ShimmerStyle"
                    android:id="@+id/driverFirst"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/teamName"
                    android:layout_marginEnd="5dp" />
                <TextView
                    style="@style/ShimmerStyle"
                    android:layout_marginStart="5dp"
                    android:textColor="@color/white"
                    android:id="@+id/driverSecond"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/teamName"
                    android:layout_toEndOf="@id/driverFirst"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="10dp"
                    style="@style/ShimmerStyle"
                    android:layout_below="@id/driverFirst"
                    android:id="@+id/team_points_text"
                    android:gravity="center"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="10dp"
                    style="@style/ShimmerStyle"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@id/team_points_text"
                    android:layout_below="@id/driverFirst"
                    android:id="@+id/team_pts"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"/>
            </RelativeLayout>
            <com.google.android.material.imageview.ShapeableImageView
                android:layout_marginTop="5dp"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="5dp"
                style="@style/ShimmerStyle"
                android:layout_weight="1.5"
                android:id="@+id/team_car"
                android:layout_width="0dp"
                android:layout_gravity="center"
                android:scaleType="centerCrop"
                android:layout_height="match_parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_card_custom_corners"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>