<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/displayedAwardPickerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/displayedAwardPickerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/header_color"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/displayedAwardPickerBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="14dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/back_arrow"
            android:contentDescription="@string/back_arrow" />

        <TextView
            android:id="@+id/raceTitile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/displayed_award_choose"
            android:textColor="@color/white"
            android:textAllCaps="true"
            android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"
            android:textSize="20sp" />

        <Space
            android:layout_width="48dp"
            android:layout_height="48dp" />

    </LinearLayout>

    <View
        android:id="@+id/separatorLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/separator_header" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:text="@string/displayed_award_hint"
        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
        android:textColor="@color/grey"
        android:textSize="13sp" />

    <!-- Thin refresh indicator. Invisible, not gone, so the list never jumps. -->
    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/displayedAwardPickerUpdating"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:visibility="invisible"
        app:shimmer_auto_start="false"
        app:shimmer_duration="1200">

        <View
            style="@style/ShimmerStyle"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.facebook.shimmer.ShimmerFrameLayout>

    <!-- One area, three mutually exclusive contents: list, skeleton, error panel. -->
    <FrameLayout
        android:id="@+id/displayedAwardPickerContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/displayedAwardPickerScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="false"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/displayedAwardPickerRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp" />

        </ScrollView>

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/displayedAwardPickerSkeleton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/displayed_award_loading"
            android:visibility="gone"
            app:shimmer_auto_start="false"
            app:shimmer_duration="1200">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <include layout="@layout/item_displayed_award_picker_shimmer" />

                <include layout="@layout/item_displayed_award_picker_shimmer" />

                <include layout="@layout/item_displayed_award_picker_shimmer" />

                <include layout="@layout/item_displayed_award_picker_shimmer" />

                <include layout="@layout/item_displayed_award_picker_shimmer" />

            </LinearLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>

        <LinearLayout
            android:id="@+id/displayedAwardPickerStatePanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:text="@string/displayed_award_list_error"
                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                android:textColor="@color/text_color_main"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/displayedAwardPickerRetry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_displayed_award_picker_save"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minWidth="160dp"
                android:minHeight="48dp"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:text="@string/displayed_award_retry"
                android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"
                android:textColor="@color/text_color_main"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>

    <!-- Short messages: save error, refresh error, unavailable award. Hidden by default. -->
    <LinearLayout
        android:id="@+id/displayedAwardPickerBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:accessibilityLiveRegion="polite"
        android:background="@drawable/bg_displayed_award_picker_banner"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/displayedAwardPickerBannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
            android:textColor="@color/text_color_main"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/displayedAwardPickerBannerAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/displayed_award_retry"
            android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
            android:textColor="@color/neuro_accent"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:textAllCaps="true"
        android:id="@+id/displayedAwardPickerSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.4"
        android:background="@drawable/bg_displayed_award_picker_save"
        android:clickable="true"
        android:enabled="false"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="52dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:text="@string/displayed_award_save"
        android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"
        android:textColor="@color/text_color_main"
        android:textSize="15sp" />

</LinearLayout>
