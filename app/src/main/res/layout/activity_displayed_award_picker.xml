<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/displayedAwardPickerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/displayedAwardPickerHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/header_color"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/displayedAwardPickerBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="14dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/back_arrow"
            android:contentDescription="@string/back_arrow" />

        <TextView
            android:id="@+id/raceTitile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/displayed_award_choose"
            android:textColor="@color/white"
            android:textAllCaps="true"
            android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"
            android:textSize="20sp" />
        <Space
            android:layout_width="48dp"
            android:layout_height="48dp"/>
    </LinearLayout>
    <View
        android:id="@+id/separatorLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/separator_header" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:text="@string/displayed_award_hint"
        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
        android:textColor="@color/grey"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/displayedAwardPickerState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:text="@string/displayed_award_loading"
        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
        android:textColor="@color/text_color_main"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/displayedAwardPickerRetry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="@string/displayed_award_retry"
        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
        android:textColor="@color/text_color_main"
        android:textSize="14sp"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/displayedAwardPickerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/displayedAwardPickerRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp" />

    </ScrollView>

    <TextView
        android:textAllCaps="true"
        android:id="@+id/displayedAwardPickerSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.4"
        android:background="@drawable/bg_displayed_award_picker_save"
        android:clickable="true"
        android:enabled="false"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="52dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        android:text="@string/displayed_award_save"
        android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"
        android:textColor="@color/text_color_main"
        android:textSize="15sp" />

</LinearLayout>
