<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:id="@+id/neuro_results_root"
    android:background="@color/colorPrimary"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        android:background="@color/header_color">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back_arrow"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:src="@drawable/back_arrow" />

        <TextView
            android:id="@+id/raceTitile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:text="@string/prediction"
            android:paddingEnd="8dp"
            android:gravity="center"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <ImageButton
            android:id="@+id/aboutPrediction"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/neuro_info"
            android:contentDescription="@string/neuro_design_about"
            app:tint="@color/white" />

    </LinearLayout>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:layout_alignParentBottom="true">
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp">
                <com.example.f1app.StripedRelativeLayout
                    android:id="@+id/poleLap_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_striped_lines_darkblue">
                    <LinearLayout
                        android:visibility="invisible"
                        android:id="@+id/eventHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp">
                        <TextView
                            android:id="@+id/race_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                            android:textColor="@color/white"
                            android:textSize="16sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="•"
                            android:textSize="16sp"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="5dp"
                            android:textColor="@color/white"/>
                        <TextView
                            android:id="@+id/year"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                            android:textColor="@color/white"
                            android:textSize="16sp"/>
                    </LinearLayout>
                    <TextView
                        android:layout_below="@id/eventHeader"
                        android:id="@+id/event_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:layout_marginTop="5dp"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"/>

                    <RelativeLayout
                        android:id="@+id/poleLap"
                        android:layout_marginTop="10dp"
                        android:layout_below="@id/event_type"
                        style="@style/PtsStyle"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/statusBar_color">
                        <TextView
                            android:id="@+id/poleLap_header"
                            android:layout_width="match_parent"
                            android:layout_marginEnd="10dp"
                            android:layout_height="wrap_content"
                            android:text="@string/pole_position"
                            android:textAllCaps="true"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                            android:textColor="@color/red"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:layout_marginTop="10dp"
                            android:layout_marginStart="10dp"/>
                        <RelativeLayout
                            android:id="@+id/loading_weather_layout"
                            android:layout_below="@id/poleLap_header"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="10dp"
                            android:minHeight="28dp">
                            <ProgressBar
                                android:id="@+id/weather_progress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="28dp"
                                android:max="100"
                                android:progress="0"
                                android:indeterminate="false"
                                android:progressDrawable="@drawable/progress_prediction" />

                            <TextView
                                android:visibility="gone"
                                android:id="@+id/loading_weather_percent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="28dp"
                                android:gravity="center"
                                android:paddingTop="4dp"
                                android:paddingBottom="4dp"
                                android:text="0%"
                                android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/loading_weather_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="28dp"
                                android:gravity="center"
                                android:textStyle="normal"
                                android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                                android:textColor="@color/white"
                                android:text="Подготовка данных события..."
                                android:textSize="15sp" />

                        </RelativeLayout>
                        <LinearLayout
                            android:id="@+id/poleLapDriver_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/loading_weather_layout"
                            android:visibility="gone"
                            android:paddingStart="10dp"
                            android:paddingEnd="15dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:id="@+id/poleLapDriverName"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:textAllCaps="true"
                                android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/poleLapTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                                android:textColor="@color/white"
                                android:textSize="20sp" />

                        </LinearLayout>
                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:visibility="visible"
                            android:id="@+id/shimmer_layout_driver"
                            android:layout_below="@id/loading_weather_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <include layout="@layout/shimmer_fastest_lap"/>
                        </com.facebook.shimmer.ShimmerFrameLayout>
                        <LinearLayout
                            android:id="@+id/update_date_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/poleLapDriver_layout"
                            android:visibility="gone"
                            android:paddingStart="10dp"
                            android:paddingEnd="15dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:id="@+id/last_update_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/last_update_text"
                                android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                                android:textColor="@color/white"
                                android:textSize="14sp"/>

                            <TextView
                                android:layout_marginStart="5dp"
                                android:id="@+id/last_update_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                                android:textColor="@color/white"
                                android:textSize="14sp"
                                tools:text="16/09/2026 20:26:23" />

                        </LinearLayout>
                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:visibility="visible"
                            android:id="@+id/shimmer_layout_last_update"
                            android:layout_below="@id/shimmer_layout_driver"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <include layout="@layout/shimmer_last_update"/>
                        </com.facebook.shimmer.ShimmerFrameLayout>
                    </RelativeLayout>

                    <TextView
                        android:layout_marginTop="10dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_below="@id/poleLap"
                        android:text="@string/neuro_design_results"
                        android:textSize="13sp"
                        android:layout_marginBottom="10dp"
                        android:textColor="@color/white"/>
                </com.example.f1app.StripedRelativeLayout>
                <RelativeLayout
                    android:layout_below="@id/poleLap_layout"
                    android:background="@color/colorPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:orientation="horizontal"
                        android:background="@color/statusBar_color"
                        android:id="@+id/quali_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:weightSum="5"
                        android:gravity="center_vertical"
                        android:baselineAligned="false">
                        <TextView
                            android:text="@string/pos_header"
                            android:layout_weight="0.5"
                            android:id="@+id/driver_placement"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textAllCaps="true"
                            android:layout_gravity="center_vertical"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                            android:textColor="@color/white"
                            android:textSize="18sp"/>
                        <TextView
                            android:text="@string/driver_header"
                            android:paddingStart="15dp"
                            android:paddingEnd="8dp"
                            android:layout_width="0dp"
                            android:layout_weight="1.8"
                            android:textAllCaps="true"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:id="@+id/driverName"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                            android:textColor="@color/white"
                            android:textSize="18sp"/>
                        <TextView
                            android:text="@string/q1_header"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:paddingStart="3dp"
                            android:paddingEnd="3dp"
                            android:layout_width="0dp"
                            android:layout_weight="0.9"
                            android:layout_gravity="center"
                            android:id="@+id/Q1_time"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textAllCaps="true"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                            android:textColor="@color/white"
                            android:textSize="18sp"/>
                        <TextView
                            android:text="@string/q2_header"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:paddingStart="3dp"
                            android:paddingEnd="3dp"
                            android:layout_width="0dp"
                            android:layout_weight="0.9"
                            android:layout_gravity="center"
                            android:id="@+id/Q2_time"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textAllCaps="true"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                            android:textColor="@color/white"
                            android:textSize="18sp"/>
                        <TextView
                            android:text="@string/q3_header"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:paddingStart="3dp"
                            android:paddingEnd="3dp"
                            android:layout_width="0dp"
                            android:layout_weight="0.9"
                            android:layout_gravity="center"
                            android:id="@+id/Q3_time"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:textAllCaps="true"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                            android:textColor="@color/white"
                            android:textSize="18sp"/>
                    </LinearLayout>
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/account_settings_input_color"
                        android:id="@+id/header_line"
                        android:layout_below="@id/quali_header"/>
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/header_line">
                        <androidx.recyclerview.widget.RecyclerView
                            android:visibility="gone"
                            android:overScrollMode="never"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:id="@+id/quali_results"
                            android:nestedScrollingEnabled="false"/>
                        <com.facebook.shimmer.ShimmerFrameLayout
                            android:id="@+id/shimmer_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">
                                <include layout="@layout/shimmer_quali_result"/>
                                <include layout="@layout/shimmer_quali_result"/>
                                <include layout="@layout/shimmer_quali_result"/>
                                <include layout="@layout/shimmer_quali_result"/>
                                <include layout="@layout/shimmer_quali_result"/>
                                <include layout="@layout/shimmer_quali_result"/>
                                <include layout="@layout/shimmer_quali_result"/>
                            </LinearLayout>
                        </com.facebook.shimmer.ShimmerFrameLayout>

                    </RelativeLayout>

                </RelativeLayout>
            </RelativeLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</RelativeLayout>