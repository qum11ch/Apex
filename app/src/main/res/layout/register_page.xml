<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:orientation="vertical"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    tools:context=".registerPageActivity"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:id="@+id/header"
        android:paddingTop="40dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/header_color">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back_arrow"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:src="@drawable/back_arrow" />

        <TextView
            android:layout_gravity="center"
            android:textAllCaps="true"
            android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/register_header"
            android:textColor="@color/white"
            android:textSize="22sp"/>

        <Space
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>
    <View
        android:id="@+id/separatorLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/header"
        android:background="@color/separator_header"/>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        android:fillViewport="true"
        android:layout_below="@id/separatorLine"
        android:id="@+id/scrollView">
        <RelativeLayout
            android:paddingBottom="50dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/pageDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/register_description"
                android:textStyle="normal"
                android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                android:textColor="@color/text_color_main"/>
            <LinearLayout
                android:layout_marginTop="20dp"
                android:layout_below="@id/pageDescription"
                android:id="@+id/loginFieldGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:textStyle="normal"
                    android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                    android:id="@+id/loginLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/login_hint"
                    android:textColor="@color/text_color_main"/>

                <LinearLayout
                    android:id="@+id/loginBox"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_input_box"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:src="@drawable/login_icon" />

                    <EditText
                        android:textCursorDrawable="@null"
                        android:textColorHighlight="@color/text_color_main"
                        android:textColorLink="@color/text_color_main"
                        android:textColor="@color/text_color_main"
                        android:id="@+id/signUpLogin"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/loginText"
                        android:inputType="textPersonName"
                        android:singleLine="true"
                        android:paddingStart="18dp"
                        android:paddingEnd="8dp"
                        android:textColorHint="@color/text_color_secondary"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/loginError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/red"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/usernameFieldGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/loginFieldGroup"
                android:layout_marginTop="22dp"
                android:orientation="vertical">

                <TextView
                    android:textStyle="normal"
                    android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                    android:id="@+id/usernameLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/username_hint"
                    android:textColor="@color/text_color_main"/>

                <LinearLayout
                    android:id="@+id/usernameBox"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_input_box"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:src="@drawable/login_icon" />

                    <EditText
                        android:textCursorDrawable="@null"
                        android:textColorHighlight="@color/text_color_main"
                        android:textColorLink="@color/text_color_main"
                        android:textColor="@color/text_color_main"
                        android:id="@+id/signUpUsername"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/usernameText"
                        android:inputType="textPersonName"
                        android:singleLine="true"
                        android:paddingStart="18dp"
                        android:paddingEnd="8dp"
                        android:textColorHint="@color/text_color_secondary"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/usernameError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/red"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/emailFieldGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/usernameFieldGroup"
                android:layout_marginTop="22dp"
                android:orientation="vertical">

                <TextView
                    android:textStyle="normal"
                    android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                    android:id="@+id/emailLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/email_hint"
                    android:textColor="@color/text_color_main" />

                <LinearLayout
                    android:id="@+id/emailBox"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_input_box"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:src="@drawable/email_icon" />

                    <EditText
                        android:textCursorDrawable="@null"
                        android:textColorHighlight="@color/text_color_main"
                        android:textColorLink="@color/text_color_main"
                        android:textColor="@color/text_color_main"
                        android:id="@+id/signUpEmail"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/emailText"
                        android:inputType="textEmailAddress"
                        android:singleLine="true"
                        android:paddingStart="18dp"
                        android:paddingEnd="8dp"
                        android:textColorHint="@color/text_color_secondary"
                        android:textSize="18sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/emailError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/red"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/passwordFieldGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/emailFieldGroup"
                android:layout_marginTop="22dp"
                android:orientation="vertical">

                <TextView
                    android:textStyle="normal"
                    android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                    android:id="@+id/passwordLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/password_hint"
                    android:textColor="@color/text_color_main"/>

                <LinearLayout
                    android:id="@+id/passwordBox"
                    android:layout_width="match_parent"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_input_box"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:contentDescription="@null"
                        android:src="@drawable/password_icon" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:paddingStart="18dp"
                        android:paddingEnd="0dp"
                        android:id="@+id/passwordInputLayout"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        app:endIconMode="password_toggle"
                        app:boxStrokeColor="@color/text_color_main"
                        app:endIconTint="@color/text_color_secondary"
                        app:boxBackgroundMode="none"
                        android:background="@null"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:hintEnabled="false">

                        <com.google.android.material.textfield.TextInputEditText
                            android:textCursorDrawable="@null"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp"
                            android:id="@+id/signUpPassword"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:hint="@string/passwordText"
                            android:background="@null"
                            android:inputType="textPassword"
                            android:singleLine="true"
                            android:textColor="@color/text_color_main"
                            android:textColorHint="@color/text_color_secondary"
                            android:textSize="18sp" />

                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/passwordError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/red"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>
            <TextView
                android:id="@+id/avatar_header"
                android:layout_marginTop="20dp"
                android:textStyle="normal"
                android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                android:layout_below="@id/passwordFieldGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/avatarText"
                android:textColor="@color/text_color_main"/>

            <LinearLayout
                android:layout_below="@id/avatar_header"
                android:layout_marginTop="10dp"
                android:id="@+id/avatarCard"
                style="@style/RegistrationStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="16dp">

                <FrameLayout
                    android:id="@+id/avatarContainer"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/avatar_bg"
                    android:backgroundTint="@color/grey">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/avatarImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/change_avatar"
                        android:scaleType="centerCrop" />

                    <TextView
                        android:id="@+id/avatarInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/text_color_main"
                        android:textSize="30sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <Button
                    android:layout_marginStart="20dp"
                    android:id="@+id/changeAvatarButton"
                    style="@style/ButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:backgroundTint="@color/grey"
                    android:text="@string/change_avatar"
                    android:textAllCaps="false"
                    android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                    android:textColor="@color/white" />
            </LinearLayout>
            <TextView
                android:textColor="@color/text_color_main"
                android:textStyle="normal"
                android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                android:id="@+id/favoriteText"
                android:layout_below="@id/avatarCard"
                android:layout_marginTop="15dp"
                android:gravity="bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/account_fav_text"/>
            <LinearLayout
                android:layout_below="@id/favoriteText"
                android:id="@+id/favDriverTeams_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="2">
                <RelativeLayout
                    android:minHeight="76dp"
                    android:id="@+id/userFavTeam_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp">
                    <RelativeLayout
                        style="@style/ItemStylePreds"
                        android:id="@+id/team_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:padding="8dp">
                        <RelativeLayout
                            android:id="@+id/teamPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="130dp"
                            style="@style/ItemStylePreds"
                            android:backgroundTint="@color/colorPrimary">
                            <ImageView
                                android:id="@+id/teamCar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_margin="6dp"
                                android:contentDescription="@string/team_car"
                                android:scaleType="fitCenter"
                                android:visibility="invisible" />
                            <TextView
                                android:text="+"
                                android:textStyle="normal"
                                android:textSize="48sp"
                                android:textColor="@color/grey"
                                android:id="@+id/noTeam"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"
                                android:gravity="center"
                                android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                                android:visibility="invisible" />
                        </RelativeLayout>
                        <RelativeLayout
                            android:minHeight="76dp"
                            android:id="@+id/teamName_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/teamPhoto"
                            android:paddingTop="10dp"
                            android:paddingBottom="4dp">
                            <TextView
                                android:gravity="center"
                                android:textAlignment="center"
                                android:id="@+id/teamName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:textStyle="bold"
                                android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForNames" />
                        </RelativeLayout>
                    </RelativeLayout>
                </RelativeLayout>
                <RelativeLayout
                    android:id="@+id/userFavDriver_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp">
                    <RelativeLayout
                        android:id="@+id/driver_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:padding="8dp"
                        style="@style/ItemStylePreds">

                        <RelativeLayout
                            android:id="@+id/driverPhoto"
                            android:layout_width="match_parent"
                            android:layout_height="130dp"
                            style="@style/ItemStylePreds"
                            android:backgroundTint="@color/colorPrimary">
                            <ImageView
                                android:id="@+id/driver_image"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/driverimage"
                                android:scaleType="fitCenter" />
                            <TextView
                                android:id="@+id/noDriver"
                                android:text="+"
                                android:textSize="48sp"
                                android:textStyle="normal"
                                android:textColor="@color/grey"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_centerInParent="true"
                                android:layout_marginStart="8dp"
                                android:layout_marginEnd="8dp"
                                android:gravity="center"
                                android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                                android:visibility="invisible" />
                        </RelativeLayout>

                        <LinearLayout
                            android:id="@+id/driverName_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/driverPhoto"
                            android:gravity="center"
                            android:minHeight="76dp"
                            android:orientation="vertical"
                            android:paddingTop="10dp"
                            android:paddingBottom="4dp">
                            <TextView
                                android:id="@+id/driverName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAlignment="center"
                                android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForNames" />
                            <TextView
                                android:id="@+id/driverFamilyName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textAlignment="center"
                                android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader" />
                        </LinearLayout>
                    </RelativeLayout>
                </RelativeLayout>
            </LinearLayout>
            <FrameLayout
                android:layout_below="@id/favDriverTeams_layout"
                android:id="@+id/registerButton_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp">
                <ProgressBar
                    android:backgroundTint="@color/red"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center_horizontal"
                    android:visibility="invisible"
                    android:id="@+id/registerProgress"
                    android:indeterminate="true"
                    android:indeterminateTintMode="src_atop"
                    android:indeterminateTint="@color/red"/>
                <Button
                    android:enabled="false"
                    android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:elevation="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/registerButton"
                    android:text="@string/registerButton"
                    style="@style/ButtonStyle"/>
            </FrameLayout>
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>