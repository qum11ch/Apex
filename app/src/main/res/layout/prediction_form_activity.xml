<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    android:id="@+id/mainLayout"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:background="@drawable/blue_gradient">
    <FrameLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <RelativeLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:layout_marginTop="40dp"
                    android:id="@+id/headerLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageButton
                        android:layout_centerVertical="true"
                        android:id="@+id/backButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/back_arrow"
                        android:padding="12dp"
                        android:src="@drawable/back_arrow" />
                    <TextView
                        android:id="@+id/prediction_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/backButton"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="32dp"
                        android:minHeight="40dp"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="1.15"
                        android:lineSpacingExtra="2dp"
                        android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo" />
                </RelativeLayout>
                <LinearLayout
                    android:weightSum="7"
                    android:layout_marginTop="20dp"
                    android:layout_below="@id/headerLayout"
                    android:id="@+id/prediction_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:paddingStart="20dp"
                        android:paddingEnd="0dp"
                        android:layout_weight="5"
                        android:textColor="@color/grey"
                        android:layout_marginEnd="20dp"
                        android:textStyle="normal"
                        android:layout_width="0dp"
                        android:id="@+id/eventName"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo" />
                    <TextView
                        android:layout_weight="2"
                        android:id="@+id/points"
                        style="@style/ResultsStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:maxWidth="50dp"
                        android:minHeight="20dp"
                        android:minWidth="20dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="14dp"
                        android:layout_marginEnd="20dp"
                        android:gravity="center"
                        android:textAllCaps="true"
                        android:textAppearance="@style/TextStyle.Audiowide.ForPTS"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </LinearLayout>
                <TextView
                    android:layout_marginBottom="20dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:layout_below="@id/prediction_header"
                    android:textStyle="normal"
                    android:layout_marginTop="10dp"
                    android:id="@+id/eventDeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/grey"
                    android:textSize="16sp"
                    android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo" />
            </RelativeLayout>
            <androidx.core.widget.NestedScrollView
                android:clipToPadding="false"
                android:paddingBottom="0dp"
                android:id="@+id/contentScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">
                <LinearLayout
                    android:paddingBottom="130dp"
                    style="@style/PredictionItemLayout"
                    android:id="@+id/scrollContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:layout_marginTop="20dp"
                        android:textAlignment="center"
                        android:textColor="@color/text_color_main"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:text="@string/prediction_choose_text"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                        android:id="@+id/choicePrediction_hint"/>

                    <LinearLayout
                        android:id="@+id/answerContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="20dp"
                        android:orientation="vertical"
                        android:gravity="center_horizontal">

                        <com.shawnlin.numberpicker.NumberPicker
                            android:paddingEnd="10dp"
                            android:paddingStart="10dp"
                            style="@style/PredictionStatusLayout"
                            android:id="@+id/answer_picker"
                            android:layout_width="match_parent"
                            android:layout_height="300dp"
                            app:np_dividerColor="@android:color/transparent"
                            app:np_dividerType="underline"
                            app:np_orientation="vertical"
                            app:np_selectedTextColor="@color/red"
                            app:np_textColor="@color/text_color_main"
                            app:np_selectedTextSize="20sp"
                            app:np_textSize="16sp" />

                        <LinearLayout
                            android:id="@+id/twoOptionsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:visibility="gone" />

                    </LinearLayout>

                    <LinearLayout
                        android:visibility="gone"
                        android:id="@+id/statusLayout"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginEnd="20dp"
                        style="@style/PredictionStatusLayout"
                        android:layout_marginTop="16dp"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2">
                            <TextView
                                android:layout_weight="1"
                                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                                android:id="@+id/savedAnswerInfo"
                                android:layout_width="0dp"
                                android:layout_marginEnd="10dp"
                                android:layout_height="wrap_content"
                                android:text="@string/prediction_choice"
                                android:textColor="@color/text_color_main"
                                android:textSize="15sp" />
                            <TextView
                                android:textStyle="bold"
                                android:layout_weight="1"
                                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                                android:id="@+id/savedAnswer"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_color_main"
                                android:textSize="15sp"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2">
                            <TextView
                                android:layout_weight="1"
                                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                                android:id="@+id/submittedAtInfo"
                                android:layout_width="0dp"
                                android:layout_marginEnd="10dp"
                                android:layout_height="wrap_content"
                                android:text="@string/prediction_submitted_text"
                                android:textColor="@color/text_color_main"
                                android:textSize="15sp" />
                            <TextView
                                android:textStyle="bold"
                                android:layout_weight="1"
                                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                                android:id="@+id/submittedAt"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_color_main"
                                android:textSize="15sp"/>
                        </LinearLayout>
                        <TextView
                            android:textAlignment="center"
                            android:layout_marginTop="5dp"
                            android:textStyle="bold"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                            android:id="@+id/answerResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_color_main"
                            android:textSize="15sp"/>
                        <LinearLayout
                            android:layout_marginTop="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="2">
                            <TextView
                                android:layout_weight="1"
                                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                                android:id="@+id/pointsEarnedInfo"
                                android:layout_width="0dp"
                                android:layout_marginEnd="10dp"
                                android:layout_height="wrap_content"
                                android:text="@string/user_predictions_stats_points"
                                android:textColor="@color/text_color_main"
                                android:textSize="15sp" />
                            <TextView
                                android:textStyle="bold"
                                android:layout_weight="1"
                                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                                android:id="@+id/pointsEarned"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_color_main"
                                android:textSize="15sp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/saveLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@android:color/transparent"
            android:elevation="8dp">

            <ProgressBar
                android:id="@+id/saveProgress"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:visibility="invisible"
                android:layout_marginBottom="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>

            <Button
                android:layout_marginBottom="40dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/save_button_text"
                android:textAllCaps="true"
                android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                style="@style/ButtonStyle" />

        </FrameLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>