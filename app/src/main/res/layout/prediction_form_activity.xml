<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/blue_gradient">

    <FrameLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <RelativeLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:id="@+id/headerLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/backButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/back_arrow"
                        android:padding="12dp"
                        android:src="@drawable/back_arrow" />

                    <TextView
                        android:id="@+id/prediction_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:minHeight="40dp"
                        android:textAlignment="center"
                        android:textColor="@color/white"
                        android:textSize="21sp"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="1.15"
                        android:lineSpacingExtra="2dp"
                        android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo" />

                    <ImageButton
                        android:id="@+id/refreshButton"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/refresh"
                        android:padding="12dp"
                        android:src="@android:drawable/ic_popup_sync"
                        app:tint="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/prediction_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/headerLayout"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/eventName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:paddingStart="16dp"
                        android:paddingEnd="0dp"
                        android:textColor="@color/grey"
                        android:textStyle="normal"
                        android:textSize="16sp"
                        android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo" />

                    <TextView
                        android:id="@+id/points"
                        style="@style/ResultsStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:gravity="center"
                        android:minWidth="40dp"
                        android:minHeight="32dp"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:textAllCaps="true"
                        android:textAppearance="@style/TextStyle.Audiowide.ForPTS"
                        android:textColor="@color/white"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/eventDeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/prediction_header"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="16dp"
                    android:includeFontPadding="false"
                    android:textColor="@color/grey"
                    android:textSize="16sp"
                    android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo" />
            </RelativeLayout>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/contentScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/scrollContent"
                    style="@style/PredictionItemLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="24dp">

                    <TextView
                        android:id="@+id/choicePrediction_hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="22dp"
                        android:layout_marginEnd="14dp"
                        android:text="@string/prediction_choose_text"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                        android:textColor="@color/text_color_main"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/answerContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="12dp"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <include layout="@layout/view_prediction_selected_participant" />

                        <LinearLayout
                            android:id="@+id/twoOptionsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- statistics: a results card -->
                    <LinearLayout
                        android:id="@+id/predictionStatsCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_results_card"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/predictionStatsTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/prediction_stats_title"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                            android:textColor="@color/text_color_main"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/predictionStatsBody"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                            android:textColor="@color/grey"
                            android:textSize="14sp" />

                        <FrameLayout
                            android:id="@+id/predictionStatsCustomContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:visibility="gone" />

                        <ProgressBar
                            android:id="@+id/predictionStatsProgress"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="12dp"
                            android:indeterminate="true"
                            android:indeterminateTint="@color/progressBarColor"
                            android:indeterminateTintMode="src_atop"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- race weekend card -->
                    <LinearLayout
                        android:id="@+id/predictionWeekendCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_results_card"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:visibility="gone">

                        <FrameLayout
                            android:id="@+id/predictionWeekendContent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <ProgressBar
                            android:id="@+id/predictionWeekendProgress"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"
                            android:indeterminate="true"
                            android:indeterminateTint="@color/progressBarColor"
                            android:indeterminateTintMode="src_atop"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/predictionWeekendError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/prediction_stats_unavailable"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                            android:textColor="@color/grey"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/predictionWeekendOpenButton"
                            style="@style/ButtonStyle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:backgroundTint="@color/grey"
                            android:minHeight="48dp"
                            android:text="@string/prediction_stats_open_weekend"
                            android:textAllCaps="true"
                            android:textAppearance="@style/TextStyle.GoodTiming.Regular"
                            android:textColor="@color/stroke_option_color"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- the saved answer: rows with dividers, like the team page -->
                    <LinearLayout
                        android:id="@+id/statusLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_results_card"
                        android:divider="@drawable/divider_results"
                        android:orientation="vertical"
                        android:showDividers="middle"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="52dp"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:id="@+id/savedAnswerInfo"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:text="@string/prediction_choice"
                                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                                android:textColor="@color/grey"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/savedAnswer"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.4"
                                android:gravity="end"
                                android:includeFontPadding="false"
                                android:maxLines="2"
                                android:textAppearance="@style/TextStyle.GoodTiming.Regular"
                                android:textColor="@color/text_color_main"
                                android:textSize="16sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="52dp"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:id="@+id/submittedAtInfo"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:text="@string/prediction_submitted_text"
                                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                                android:textColor="@color/grey"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/submittedAt"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.4"
                                android:gravity="end"
                                android:includeFontPadding="false"
                                android:maxLines="2"
                                android:textAppearance="@style/TextStyle.GoodTiming.Regular"
                                android:textColor="@color/text_color_main"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/answerResult"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:minHeight="48dp"
                            android:paddingStart="14dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="10dp"
                            android:textAppearance="@style/TextStyle.GoodTiming.Bold"
                            android:textColor="@color/text_color_main"
                            android:textSize="15sp" />

                        <LinearLayout
                            android:visibility="gone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minHeight="52dp"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="10dp">

                            <TextView
                                android:id="@+id/pointsEarnedInfo"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="8dp"
                                android:layout_weight="1"
                                android:includeFontPadding="false"
                                android:text="@string/user_predictions_stats_points"
                                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                                android:textColor="@color/grey"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/pointsEarned"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.4"
                                android:gravity="end"
                                android:includeFontPadding="false"
                                android:maxLines="2"
                                android:textAppearance="@style/TextStyle.GoodTiming.Regular"
                                android:textColor="@color/text_color_main"
                                android:textSize="16sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/aboutPrediction"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="14dp"
                        android:orientation="horizontal"
                        tools:ignore="UseCompoundDrawables">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/pred_rules_button"
                            android:padding="4dp"
                            android:src="@drawable/neuro_info"
                            app:tint="@color/grey" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:minHeight="48dp"
                            android:paddingStart="4dp"
                            android:text="@string/pred_rules_button"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                            android:textColor="@color/grey"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/saveLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@android:color/transparent"
            android:elevation="8dp"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="12dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/saveButton"
                style="@style/ButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="@string/save_button_text"
                android:textAllCaps="true"
                android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/saveProgress"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/progressBarColor"
                android:indeterminateTintMode="src_atop"
                android:visibility="invisible" />
        </FrameLayout>
    </FrameLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
