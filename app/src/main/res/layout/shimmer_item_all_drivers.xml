<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        tools:ignore="MissingConstraints"
        android:backgroundTint="@android:color/transparent">
        <androidx.cardview.widget.CardView
            android:id="@+id/first_driver"
            android:layout_width="0dp"
            android:layout_weight="1"
            app:cardElevation="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:id="@+id/first_driver_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/favDriver_header_row"
                android:padding="8dp"
                style="@style/ShimmerStyle"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/first_driverPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    style="@style/ItemStylePreds"
                    android:backgroundTint="@color/colorPrimary">
                    <ImageView
                        android:id="@+id/first_driver_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/driverimage"
                        android:scaleType="fitCenter" />
                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/first_driverName_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="4dp">
                    <TextView
                        style="@style/ShimmerStyle"
                        android:backgroundTint="@color/colorPrimary"
                        android:id="@+id/first_driverName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForNames" />
                    <TextView
                        android:layout_marginTop="2dp"
                        style="@style/ShimmerStyle"
                        android:backgroundTint="@color/colorPrimary"
                        android:id="@+id/first_driverFamilyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:id="@+id/second_driver"
            android:layout_width="0dp"
            android:layout_weight="1"
            app:cardElevation="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            app:cardCornerRadius="8dp">
            <LinearLayout
                android:id="@+id/second_driver_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/favDriver_header_row"
                android:padding="8dp"
                style="@style/ShimmerStyle"
                android:orientation="vertical">

                <RelativeLayout
                    android:id="@+id/driverPhoto"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    style="@style/ItemStylePreds"
                    android:backgroundTint="@color/colorPrimary">
                    <ImageView
                        android:id="@+id/driver_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/driverimage"
                        android:scaleType="fitCenter" />
                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/second_driverName_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:minHeight="76dp"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="4dp">
                    <TextView
                        style="@style/ShimmerStyle"
                        android:backgroundTint="@color/colorPrimary"
                        android:id="@+id/second_driverName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForNames" />
                    <TextView
                        android:layout_marginTop="2dp"
                        style="@style/ShimmerStyle"
                        android:backgroundTint="@color/colorPrimary"
                        android:id="@+id/second_driverFamilyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>