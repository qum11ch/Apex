<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:id="@+id/item_driver_line"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:backgroundTint="@color/colorPrimary"
            style="@style/ItemStyleAlt"
            android:layout_marginBottom="5dp">
            <RelativeLayout
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:layout_marginEnd="5dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="100dp">
                <TextView
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginEnd="10dp"
                    style="@style/ShimmerStyle"
                    android:paddingStart="5dp"
                    android:paddingEnd="0dp"
                    android:id="@+id/driver_placement"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="5dp" />
                <RelativeLayout
                    android:layout_toEndOf="@id/driver_placement"
                    android:layout_marginBottom="5dp"
                    android:layout_marginEnd="8dp"
                    android:id="@+id/driver_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    tools:ignore="RelativeOverlap">
                    <TextView
                        style="@style/ShimmerStyle"
                        android:id='@+id/driverName'
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"/>
                    <TextView
                        style="@style/ShimmerStyle"
                        android:layout_toEndOf="@id/driverName"
                        android:layout_marginStart="5dp"
                        android:id='@+id/driverFamilyName'
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader" />
                    <TextView
                        android:layout_marginTop="5dp"
                        style="@style/ShimmerStyle"
                        android:id="@+id/driverTeam"
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/driverFamilyName"
                        android:layout_marginEnd="4dp"
                        android:textAppearance="@style/TextStyle.ShareTechCYR.ForInfo" />
                    <TextView
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="10dp"
                        style="@style/ShimmerStyle"
                        android:layout_below="@id/driverTeam"
                        android:id="@+id/team_points_text"
                        android:gravity="center"
                        android:layout_width="60dp"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="10dp"
                        style="@style/ShimmerStyle"
                        android:layout_marginStart="5dp"
                        android:layout_toEndOf="@id/team_points_text"
                        android:layout_below="@id/driverTeam"
                        android:id="@+id/team_pts"
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"/>
                </RelativeLayout>
                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="5dp"
                    android:layout_marginBottom="5dp"
                    style="@style/ShimmerStyle"
                    android:layout_alignParentEnd="true"
                    android:id="@+id/driverImage"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay_card_custom_corners"/>
            </RelativeLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>