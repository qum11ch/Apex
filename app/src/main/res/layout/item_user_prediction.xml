<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/swipeBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:background="@drawable/bg_swipe_delete"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="@id/cardView"
        app:layout_constraintBottom_toBottomOf="@id/cardView"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="24dp"
            android:src="@drawable/delete_white" />
    </FrameLayout>
    <androidx.cardview.widget.CardView
        android:outlineProvider="none"
        android:stateListAnimator="@null"
        app:cardUseCompatPadding="false"
        app:cardPreventCornerOverlap="false"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="0dp"
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:id="@+id/content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/bg_user_prediction_card"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <RelativeLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/userPredictionEvent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.1"
                    android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                    android:textColor="@color/text_color_secondary"
                    android:textSize="12sp" />
            </RelativeLayout>

            <TextView
                android:id="@+id/userPredictionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/header"
                android:layout_marginTop="8dp"
                android:gravity="start"
                android:includeFontPadding="false"
                android:lineSpacingMultiplier="1.15"
                android:textAlignment="viewStart"
                android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                android:textColor="@color/text_color_main"
                android:textSize="17sp" />

            <LinearLayout
                android:id="@+id/userAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/userPredictionTitle"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/userPredictionAnswer_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/prediction_answer_prefix"
                    android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                    android:textColor="@color/text_color_secondary"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/userPredictionAnswer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                    android:textColor="@color/text_color_main"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:id="@+id/resultDivider"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_below="@id/userAnswer"
                android:layout_marginTop="12dp"
                android:background="@color/colorPrimary" />

            <RelativeLayout
                android:id="@+id/resultRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/resultDivider"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/userPredictionPoints"
                    style="@style/ResultsStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:minHeight="26dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextStyle.Audiowide.ForPTS"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/userPredictionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"
                    android:layout_toStartOf="@id/userPredictionPoints"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <TextView
                android:id="@+id/userPredictionDeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/resultRow"
                android:layout_marginTop="8dp"
                android:includeFontPadding="false"
                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                android:textColor="@color/grey"
                android:textSize="13sp"
                android:visibility="gone" />

        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>
