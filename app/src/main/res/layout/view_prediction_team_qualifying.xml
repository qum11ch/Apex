<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="4dp">
            <TextView
                android:text="@string/tq_side_a"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_color_main"
                android:textSize="12sp"
                android:gravity="center"
                android:alpha="0.65"/>
            <TextView
                android:id="@+id/tqNameA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_color_main"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"/>
            <TextView
                android:id="@+id/tqAverageA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_color_main"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="4dp">
            <TextView
                android:text="@string/tq_side_b"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_color_main"
                android:textSize="12sp"
                android:gravity="center"
                android:alpha="0.65"/>
            <TextView
                android:id="@+id/tqNameB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_color_main"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"/>
            <TextView
                android:id="@+id/tqAverageB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_color_main"
                android:textSize="32sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:text="@string/tq_average"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_color_main"
        android:textSize="12sp"
        android:gravity="center"
        android:alpha="0.7"/>
    <TextView
        android:id="@+id/tqCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_color_main"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="8dp"/>
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/text_color_main"
        android:alpha="0.12"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"/>
    <TextView
        android:text="@string/tq_recent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_color_main"
        android:textSize="15sp"
        android:textStyle="bold" />
    <TextView
        android:text="@string/tq_columns"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_color_main"
        android:textSize="12sp"
        android:layout_marginTop="8dp"
        android:alpha="0.65"/>
    <LinearLayout
        android:id="@+id/tqRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"/>
    <TextView
        android:id="@+id/tqEmpty"
        android:text="@string/tq_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_color_main"
        android:textSize="13sp"
        android:layout_marginTop="8dp"
        android:visibility="gone"/>
</LinearLayout>