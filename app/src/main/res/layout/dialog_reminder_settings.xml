<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reminder_title"
        android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
        android:textColor="@color/text_color_main"
        android:textSize="18sp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/reminderSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/reminder_switch"
        android:textColor="@color/text_color_main" />

    <TextView
        android:id="@+id/reminderLeadLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/reminder_lead_label"
        android:textColor="@color/text_color_secondary"
        android:textSize="13sp" />

    <RadioGroup
        android:id="@+id/reminderLeadGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/predictionAlertsSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/prediction_alerts_switch"
        android:textColor="@color/text_color_main" />

    <TextView
        android:id="@+id/reminderBatteryHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackground"
        android:padding="4dp"
        android:text="@string/reminder_battery_hint"
        android:textColor="@color/text_color_secondary"
        android:textSize="12sp" />
</LinearLayout>