<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorPrimary"
    tools:context=".logInPageActivity">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/header"
            android:paddingTop="40dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/header_color">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:contentDescription="@string/back_arrow"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:src="@drawable/back_arrow" />

            <TextView
                android:layout_gravity="center"
                android:textAllCaps="true"
                android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/login_text"
                android:textColor="@color/white"
                android:textSize="22sp"/>

            <Space
                android:layout_width="48dp"
                android:layout_height="48dp" />
        </LinearLayout>
        <View
            android:id="@+id/separatorLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/separator_header"/>
        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <RelativeLayout
                android:layout_marginTop="150dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:id="@+id/loginFieldGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:textStyle="normal"
                        android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                        android:id="@+id/loginLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/loginText"
                        android:textColor="@color/text_color_main"/>

                    <LinearLayout
                        android:id="@+id/loginBox"
                        android:layout_width="match_parent"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_input_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="@null"
                            android:src="@drawable/login_icon" />

                        <EditText
                            android:textCursorDrawable="@null"
                            android:textColorHighlight="@color/text_color_main"
                            android:textColorLink="@color/text_color_main"
                            android:textColor="@color/text_color_main"
                            android:id="@+id/loginUsername"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/login_hint_full"
                            android:inputType="text"
                            android:singleLine="true"
                            android:paddingStart="18dp"
                            android:paddingEnd="8dp"
                            android:textColorHint="@color/text_color_secondary"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/loginError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/red"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>
                <LinearLayout
                    android:layout_below="@id/loginFieldGroup"
                    android:id="@+id/passwordFieldGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="vertical">

                    <TextView
                        android:textStyle="normal"
                        android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                        android:id="@+id/passwordLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="@string/passwordText"
                        android:textColor="@color/text_color_main"/>

                    <LinearLayout
                        android:id="@+id/passwordBox"
                        android:layout_width="match_parent"
                        android:layout_height="68dp"
                        android:background="@drawable/bg_input_box"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="@null"
                            android:src="@drawable/password_icon" />

                        <com.google.android.material.textfield.TextInputLayout
                            android:paddingStart="18dp"
                            android:paddingEnd="0dp"
                            android:id="@+id/passwordInputLayout"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            app:endIconMode="password_toggle"
                            app:boxStrokeColor="@color/text_color_main"
                            android:background="@android:color/transparent"
                            app:endIconTint="@color/text_color_secondary"
                            app:boxBackgroundMode="none"
                            app:boxStrokeWidth="0dp"
                            app:boxStrokeWidthFocused="0dp"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:textCursorDrawable="@null"
                                app:boxStrokeWidth="0dp"
                                app:boxStrokeWidthFocused="0dp"
                                android:id="@+id/loginPassword"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:hint="@string/password_hint_full"
                                android:background="@null"
                                android:inputType="textPassword"
                                android:singleLine="true"
                                android:textColor="@color/text_color_main"
                                android:textColorHint="@color/text_color_secondary"
                                android:textSize="18sp" />

                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/passwordError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textColor="@color/red"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>
                <TextView
                    android:layout_marginTop="20dp"
                    android:layout_below="@id/passwordFieldGroup"
                    android:textColor="@color/red"
                    android:textAppearance="@style/TextStyle.Gram.Bold"
                    android:textSize="18sp"
                    android:textStyle="normal"
                    style="text-decoration: underline"
                    android:id="@+id/resetPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/forgot_password" />
                <FrameLayout
                    android:layout_below="@id/resetPassword"
                    android:id="@+id/loginButton_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp">
                    <ProgressBar
                        android:backgroundTint="@color/red"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center_horizontal"
                        android:visibility="invisible"
                        android:id="@+id/loginProgress"
                        android:indeterminate="true"
                        android:indeterminateTintMode="src_atop"
                        android:indeterminateTint="@color/red"/>
                    <Button
                        android:enabled="false"
                        android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                        android:textColor="@color/white"
                        android:textStyle="bold"
                        android:elevation="0dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/loginButton"
                        android:text="@string/loginButton"
                        style="@style/ButtonStyle"/>
                </FrameLayout>
                <LinearLayout
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginEnd="20dp"
                    android:gravity="center"
                    android:layout_below="@id/loginButton_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/signUpLayout">
                    <TextView
                        android:textColor="@color/text_color_main"
                        android:textAppearance="@style/TextStyle.Gram.Regular"
                        android:textSize="20sp"
                        android:id="@+id/signUpText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/singUpText1"
                        android:textAlignment="center" />
                    <TextView
                        android:textAppearance="@style/TextStyle.Gram.Regular"
                        android:textSize="20sp"
                        android:id="@+id/signUpText2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/singUpText2"
                        android:layout_marginStart="5dp"
                        android:textColor="@color/red"
                        android:textAlignment="center" />
                </LinearLayout>
            </RelativeLayout>
        </ScrollView>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:weightSum="5"
        android:paddingStart="5dp"
        android:paddingEnd="5dp"
        android:paddingBottom="20dp">

        <View android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:clickable="true" android:focusable="true" />
        <View android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:clickable="true" android:focusable="true" />
        <View android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:clickable="true" android:focusable="true" />
        <View android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:clickable="true" android:focusable="true" />
        <View android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:clickable="true" android:focusable="true" />

    </LinearLayout>
    <include
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="20dp"
        layout="@layout/footer_account" />
</androidx.coordinatorlayout.widget.CoordinatorLayout>