<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="20dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/fullTeamName_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:text="@string/full_team_name"
                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                android:textColor="@color/grey"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/fullTeamName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextStyle.GoodTiming.Bold"
                android:textColor="@color/text_color_main"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/statisticHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginTop="28dp"
                android:text="@string/statistics_since_debut"
                android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                android:textColor="@color/text_color_main"
                android:textSize="28sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/stats_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_results_card"
                android:divider="@drawable/divider_results"
                android:orientation="vertical"
                android:showDividers="middle">

                <LinearLayout
                    android:id="@+id/stats_top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:divider="@drawable/divider_results"
                    android:orientation="horizontal"
                    android:showDividers="middle" />

                <LinearLayout
                    android:id="@+id/stats_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:divider="@drawable/divider_results"
                    android:orientation="horizontal"
                    android:showDividers="middle" />
            </LinearLayout>

            <TextView
                android:id="@+id/lineup_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginTop="28dp"
                android:text="@string/team_lineup"
                android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                android:textColor="@color/text_color_main"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/lineup_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/cars_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginTop="28dp"
                android:text="@string/team_cars_title"
                android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                android:textColor="@color/text_color_main"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.example.f1app.nestedScrollableHost
                android:id="@+id/car_pager_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/car_pager"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never" />

                <ImageButton
                    android:id="@+id/car_prev"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="start|top"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="85dp"
                    android:background="@drawable/bg_car_arrow"
                    android:contentDescription="@string/team_cars_newer"
                    android:rotation="180"
                    android:src="@drawable/ic_chevron_right_small"
                    app:tint="@color/text_color_main" />

                <ImageButton
                    android:id="@+id/car_next"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="end|top"
                    android:layout_marginTop="85dp"
                    android:layout_marginEnd="14dp"
                    android:background="@drawable/bg_car_arrow"
                    android:contentDescription="@string/team_cars_older"
                    android:src="@drawable/ic_chevron_right_small"
                    app:tint="@color/text_color_main" />
            </com.example.f1app.nestedScrollableHost>


            <TextView
                android:id="@+id/tech_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginTop="28dp"
                android:text="@string/technical_information"
                android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                android:textColor="@color/text_color_main"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/tech_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_results_card"
                android:divider="@drawable/divider_results"
                android:orientation="vertical"
                android:showDividers="middle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="@string/enter_year"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                        android:textColor="@color/grey"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/enterYear"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textAppearance="@style/TextStyle.GoodTiming.Regular"
                        android:textColor="@color/text_color_main"
                        android:textSize="16sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="@string/base"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                        android:textColor="@color/grey"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/teamBase"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textAppearance="@style/TextStyle.GoodTiming.Regular"
                        android:textColor="@color/text_color_main"
                        android:textSize="16sp" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/flag"
                        android:layout_width="40dp"
                        android:layout_height="27dp"
                        android:layout_marginStart="10dp"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/customRoundedImageView"
                        app:strokeColor="@color/grey"
                        app:strokeWidth="0.5dp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="@string/team_chief"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                        android:textColor="@color/grey"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/teamChief"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textAppearance="@style/TextStyle.GoodTiming.Regular"
                        android:textColor="@color/text_color_main"
                        android:textSize="16sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="@string/technical_chief"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                        android:textColor="@color/grey"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/techChief"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textAppearance="@style/TextStyle.GoodTiming.Regular"
                        android:textColor="@color/text_color_main"
                        android:textSize="16sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="@string/chassis"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                        android:textColor="@color/grey"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/chassis"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textAppearance="@style/TextStyle.GoodTiming.Regular"
                        android:textColor="@color/text_color_main"
                        android:textSize="16sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="@string/power_unit"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                        android:textColor="@color/grey"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/powerUnit"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textAppearance="@style/TextStyle.GoodTiming.Regular"
                        android:textColor="@color/text_color_main"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
