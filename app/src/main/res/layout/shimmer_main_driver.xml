<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.cardview.widget.CardView
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:backgroundTint="@color/light_grey"
            android:id="@+id/item_team"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="5dp"
            style="@style/ButtonStyle">
            <TextView
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                style="@style/ShimmerStyle"
                android:gravity="center"
                android:layout_width="20dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="10dp" />
            <ImageView
                style="@style/ShimmerStyle"
                android:layout_marginBottom="5dp"
                android:layout_marginTop="5dp"
                android:layout_width="70dp"
                android:layout_height="match_parent" />
            <RelativeLayout
                android:layout_marginStart="5dp"
                android:layout_marginBottom="5dp"
                android:layout_marginEnd="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">
                <TextView
                    style="@style/ShimmerStyle"
                    android:id='@+id/driverName'
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"/>
                <TextView
                    style="@style/ShimmerStyle"
                    android:layout_toEndOf="@id/driverName"
                    android:layout_marginStart="5dp"
                    android:id='@+id/driverFamilyName'
                    android:layout_width="120dp"
                    android:layout_height="wrap_content"/>
                <TextView
                    style="@style/ShimmerStyle"
                    android:layout_marginTop="5dp"
                    android:layout_below="@id/driverName"
                    android:id="@+id/driver_points_text"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="10dp"
                    style="@style/ShimmerStyle"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@id/driver_points_text"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/driverName"
                    android:id="@+id/driver_points"/>
            </RelativeLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>