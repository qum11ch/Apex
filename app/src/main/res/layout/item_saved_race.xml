<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        style="@style/ItemStylePreds"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: round, name, place, dates and the state -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/race_round"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_race_round"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="@color/white"
                android:textAppearance="@style/TextStyle.Audiowide.ForDays"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/raceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextStyle.Gram.Bold.ForTab"
                    android:textColor="@color/text_color_main"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/race_place"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_color_secondary"
                    android:textAppearance="@style/TextStyle.Gram.Regular"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/race_dates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_color_main"
                    android:textAppearance="@style/TextStyle.Gram.Regular"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/race_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_race_state"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/sprint_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_race_state"
                    android:backgroundTint="@color/race_state_sprint_bg"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="@string/race_sprint_badge"
                    android:textColor="@color/race_state_sprint"
                    android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Finished race: the podium -->
        <LinearLayout
            android:id="@+id/podium_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:weightSum="3">
                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp">
                    <com.google.android.material.imageview.ShapeableImageView
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerCircle.TopSide"
                        android:id="@+id/stripedImg_first"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/background_striped_lines_white" />
                    <ImageView
                        android:id="@+id/firstPlace_image"
                        android:layout_width="match_parent"
                        android:layout_height="84dp"
                        android:layout_alignParentBottom="true"
                        android:contentDescription="@string/driverimage"
                        android:scaleType="fitCenter" />
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp">
                    <com.google.android.material.imageview.ShapeableImageView
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerCircle.TopSide"
                        android:id="@+id/stripedImg_second"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/background_striped_lines_white" />
                    <ImageView
                        android:id="@+id/secondPlace_image"
                        android:layout_width="match_parent"
                        android:layout_height="84dp"
                        android:layout_alignParentBottom="true"
                        android:contentDescription="@string/driverimage"
                        android:scaleType="fitCenter" />
                </RelativeLayout>
                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="84dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp">
                    <com.google.android.material.imageview.ShapeableImageView
                        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerCircle.TopSide"
                        android:id="@+id/stripedImg_third"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/background_striped_lines_white" />
                    <ImageView
                        android:id="@+id/thirdPlace_image"
                        android:layout_width="match_parent"
                        android:layout_height="84dp"
                        android:layout_alignParentBottom="true"
                        android:contentDescription="@string/driverimage"
                        android:scaleType="fitCenter" />
                </RelativeLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:weightSum="3">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginEnd="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="@string/one"
                        android:textAppearance="@style/TextStyle.Audiowide.ForDays" />
                    <TextView
                        android:id="@+id/firstPlace_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textAllCaps="true"
                        android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForCodes" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="@string/two"
                        android:textAppearance="@style/TextStyle.Audiowide.ForDays" />
                    <TextView
                        android:id="@+id/secondPlace_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textAllCaps="true"
                        android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForCodes" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginStart="5dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:text="@string/three"
                        android:textAppearance="@style/TextStyle.Audiowide.ForDays" />
                    <TextView
                        android:id="@+id/thirdPlace_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textAllCaps="true"
                        android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForCodes" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Upcoming, running, waiting for results or canceled: the countdown block -->
        <LinearLayout
            android:id="@+id/countdown_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/countdown_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/round_color"
                android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                android:textSize="36sp" />
            <TextView
                android:id="@+id/countdown_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textColor="@color/text_color_main"
                android:textAppearance="@style/TextStyle.Gram.Regular"
                android:textSize="14sp" />
            <TextView
                android:id="@+id/race_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:textColor="@color/text_color_secondary"
                android:textAppearance="@style/TextStyle.Gram.Regular"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Facts: finished race -> fastest lap, driver and laps/sprint; other states -> circuit -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/stroke_option_color"
            android:alpha="0.5" />

        <LinearLayout
            android:id="@+id/stats_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:baselineAligned="false"
            android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/stat1_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_color_main"
                        android:textAppearance="@style/TextStyle.Gram.Bold.ForTab"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/stat1_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_color_secondary"
                        android:textAppearance="@style/TextStyle.Gram.Regular"
                        android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/stat2_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_color_main"
                        android:textAppearance="@style/TextStyle.Gram.Bold.ForTab"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/stat2_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_color_secondary"
                        android:textAppearance="@style/TextStyle.Gram.Regular"
                        android:textSize="12sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/stat3_value"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_color_main"
                        android:textAppearance="@style/TextStyle.Gram.Bold.ForTab"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/stat3_label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_color_secondary"
                        android:textAppearance="@style/TextStyle.Gram.Regular"
                        android:textSize="12sp" />
                </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/save_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_color_thirdly"
            android:textAppearance="@style/TextStyle.Gram.Regular"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
