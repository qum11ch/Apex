<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minHeight="118dp"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="4dp"
    android:paddingTop="10dp"
    android:paddingEnd="4dp"
    android:paddingBottom="10dp"
    android:background="@drawable/bg_profile_medal_item">

    <com.example.f1app.awardIconView
        android:id="@+id/medalIcon"
        android:layout_width="64dp"
        android:layout_height="64dp" />

    <TextView
        android:id="@+id/medalTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="3"
        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
        android:textColor="@color/text_color_main"
        android:textSize="12sp"
        android:importantForAccessibility="no" />

</LinearLayout>