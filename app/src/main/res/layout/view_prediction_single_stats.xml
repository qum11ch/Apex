<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:divider="@drawable/divider_results"
    android:showDividers="middle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/singleName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Apex.Pred.Title" />

        <TextView
            android:id="@+id/singleContext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            style="@style/Widget.Apex.Pred.Secondary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/singlePoints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.Apex.Pred.Big" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/pf_championship_points"
            style="@style/Widget.Apex.Pred.Caption" />

        <TextView
            android:id="@+id/singleAverage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            style="@style/Widget.Apex.Pred.Body" />

        <TextView
            android:id="@+id/singleCoverage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            style="@style/Widget.Apex.Pred.Caption" />

        <TextView
            android:id="@+id/singleCalendarWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            style="@style/Widget.Apex.Pred.Caption" />

        <TextView
            android:id="@+id/singleTotalWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/pf_total_mismatch"
            style="@style/Widget.Apex.Pred.Caption" />
    </LinearLayout>

    <TextView
        android:id="@+id/singleWeekendCaption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:text="@string/pf_weekend_history"
        style="@style/Widget.Apex.Pred.Gram.Bold" />

    <LinearLayout
        android:id="@+id/singleWeekendRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:divider="@drawable/divider_results"
        android:showDividers="middle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:text="@string/pf_race_performance"
        style="@style/Widget.Apex.Pred.Gram.Bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:divider="@drawable/divider_results"
        android:showDividers="middle">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/singleWins"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Apex.Pred.Number" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/pf_wins"
                style="@style/Widget.Apex.Pred.Caption" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/singlePodiums"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Apex.Pred.Number" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/pf_podiums"
                style="@style/Widget.Apex.Pred.Caption" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/singleRetirements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Apex.Pred.Number" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/pf_retirements"
                style="@style/Widget.Apex.Pred.Caption" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/singleCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        style="@style/Widget.Apex.Pred.Caption" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:text="@string/pf_main_history"
        style="@style/Widget.Apex.Pred.Gram.Bold" />

    <LinearLayout
        android:id="@+id/singleRecentRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:divider="@drawable/divider_results"
        android:showDividers="middle" />
</LinearLayout>
