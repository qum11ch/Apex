<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/singleName" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Apex.Pred.Title" />
    <TextView android:id="@+id/singleContext" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" style="@style/Widget.Apex.Pred.Caption" />
    <TextView android:id="@+id/singlePoints" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" style="@style/Widget.Apex.Pred.Big" />
    <TextView android:text="@string/pf_championship_points" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Apex.Pred.Caption" />
    <TextView android:id="@+id/singleAverage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="@style/Widget.Apex.Pred.Body" />
    <TextView android:id="@+id/singleCoverage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" style="@style/Widget.Apex.Pred.Caption" />
    <TextView android:id="@+id/singleCalendarWarning" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" style="@style/Widget.Apex.Pred.Caption" />
    <TextView android:id="@+id/singleTotalWarning" android:text="@string/pf_total_mismatch" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" style="@style/Widget.Apex.Pred.Caption" />
    <TextView android:id="@+id/singleWeekendCaption" android:text="@string/pf_weekend_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" style="@style/Widget.Apex.Pred.Section" />
    <LinearLayout android:id="@+id/singleWeekendRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:divider="@drawable/divider_results" android:showDividers="middle" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/text_color_main" android:alpha="0.12" android:layout_marginTop="16dp" android:layout_marginBottom="16dp" />
    <TextView android:text="@string/pf_race_performance" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Apex.Pred.Section" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="12dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="0dp" android:paddingEnd="6dp">
            <TextView android:id="@+id/singleWins" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Apex.Pred.Number" />
            <TextView android:text="@string/pf_wins" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Apex.Pred.Caption" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="0dp" android:paddingEnd="6dp">
            <TextView android:id="@+id/singlePodiums" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Apex.Pred.Number" />
            <TextView android:text="@string/pf_podiums" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Apex.Pred.Caption" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="0dp" android:paddingEnd="6dp">
            <TextView android:id="@+id/singleRetirements" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Apex.Pred.Number" />
            <TextView android:text="@string/pf_retirements" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Apex.Pred.Caption" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/singleCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" style="@style/Widget.Apex.Pred.Caption" />
    <TextView android:text="@string/pf_main_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" style="@style/Widget.Apex.Pred.Section" />
    <LinearLayout android:id="@+id/singleRecentRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:divider="@drawable/divider_results" android:showDividers="middle" />
</LinearLayout>
