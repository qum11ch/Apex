<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/singleName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_color_main" android:textSize="20sp" android:textStyle="bold" />
<TextView android:id="@+id/singleContext" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_color_main" android:textSize="13sp" android:alpha="0.7" android:layout_marginTop="4dp"/>
<TextView android:id="@+id/singlePoints" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_color_main" android:textSize="34sp" android:textStyle="bold" android:layout_marginTop="16dp"/>
<TextView android:text="@string/ps_main_points" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_color_main" android:textSize="12sp" android:alpha="0.7"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false" android:layout_marginTop="16dp">
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="6dp">
<TextView android:id="@+id/singleWins" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_color_main" android:textSize="22sp" android:textStyle="bold" />
<TextView android:text="@string/ps_wins" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_color_main" android:textSize="12sp" android:alpha="0.7"/>
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="6dp">
<TextView android:id="@+id/singlePodiums" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_color_main" android:textSize="22sp" android:textStyle="bold" />
<TextView android:text="@string/ps_podiums" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_color_main" android:textSize="12sp" android:alpha="0.7"/>
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingEnd="6dp">
<TextView android:id="@+id/singleRetirements" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_color_main" android:textSize="22sp" android:textStyle="bold" />
<TextView android:text="@string/ps_retirements" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_color_main" android:textSize="12sp" android:alpha="0.7"/>
</LinearLayout>
</LinearLayout>
<TextView android:id="@+id/singleAverage" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_color_main" android:textSize="14sp" android:layout_marginTop="16dp"/>
<TextView android:id="@+id/singleCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_color_main" android:textSize="13sp" android:layout_marginTop="4dp" android:alpha="0.7"/>
<View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/text_color_main" android:alpha="0.12" android:layout_marginTop="16dp" android:layout_marginBottom="16dp"/>
<TextView android:text="@string/ps_recent" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_color_main" android:textSize="15sp" android:textStyle="bold" />
<TextView android:id="@+id/singleResultHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_color_main" android:textSize="12sp" android:gravity="end" android:alpha="0.7" android:layout_marginTop="8dp"/>
<LinearLayout android:id="@+id/singleRecentRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
<TextView android:id="@+id/singleEmpty" android:text="@string/ps_no_events" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_color_main" android:textSize="13sp" android:layout_marginTop="8dp" android:visibility="gone"/>
<TextView android:id="@+id/singleFootnote" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_color_main" android:textSize="12sp" android:layout_marginTop="12dp" android:alpha="0.65"/>
</LinearLayout>