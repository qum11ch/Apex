<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:id="@+id/neuro_predict_root"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        android:background="@color/header_color">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back_arrow"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:src="@drawable/back_arrow" />

        <TextView
            android:id="@+id/raceTitile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:text="@string/predict"
            android:paddingEnd="8dp"
            android:gravity="center"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <Space
            android:layout_width="48dp"
            android:layout_height="48dp" />

    </LinearLayout>
    <View
        android:id="@+id/separatorLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/header"
        android:background="@color/separator_header" />
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/separatorLine"
        android:layout_alignParentBottom="true"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingBottom="24dp">
            <TextView
                android:textStyle="normal"
                android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                android:textColor="@color/text_color_main"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:id="@+id/predict_info_text"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/predict_info_text"/>

            <FrameLayout
                android:id="@+id/frame_layout"
                android:layout_below="@id/predict_info_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp">

                <View
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:background="@drawable/picker_highlight_background" />

                <com.shawnlin.numberpicker.NumberPicker
                    android:id="@+id/numberpicker"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:np_orientation="vertical"
                    app:np_selectedTextColor="@color/colorPrimary"
                    app:np_textColor="@color/text_color_main"
                    app:np_selectedTextSize="20sp"
                    app:np_textSize="14sp"
                    app:np_dividerColor="@android:color/transparent"/>
            </FrameLayout>
            <RadioGroup
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_below="@id/frame_layout"
                android:id="@+id/radioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <RadioButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/text_color_main"
                    android:buttonTint="@drawable/radio_color"
                    android:textStyle="normal"
                    android:checked="true"
                    android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                    android:id="@+id/radio1"
                    android:text="@string/predict_quali"
                    android:tag="Q"/>

                <RadioButton
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/text_color_main"
                    android:buttonTint="@drawable/radio_color"
                    android:textStyle="normal"
                    android:layout_marginTop="15dp"
                    android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                    android:checked="false"
                    android:id="@+id/radio2"
                    android:text="@string/predict_sprint_quali"
                    android:tag="SQ"/>
            </RadioGroup>
            <Button
                android:minHeight="60dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="30dp"
                android:text="@string/predict_button"
                android:layout_below="@id/radioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/predict_button"
                android:textSize="16sp"
                android:enabled="true"
                android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:elevation="0dp"
                android:textAllCaps="true"
                style="@style/ButtonStyle"/>
        </RelativeLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>