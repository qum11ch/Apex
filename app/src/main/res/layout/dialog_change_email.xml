<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/colorPrimary"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="15dp"
    app:cardElevation="15dp">
    <LinearLayout
        android:layout_marginTop="30dp"
        android:layout_marginBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:textAllCaps="true"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/dialogTitle"
            android:text="@string/change_email"
            android:textColor="@color/text_color_main"
            android:textStyle="bold"
            android:textSize="21sp"
            android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader" />
        <TextView
            android:textAlignment="center"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:id="@+id/dialogDescription"
            android:layout_marginTop="13dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/grey"
            android:text="@string/dialog_change_email_description"
            android:textAppearance="@style/TextStyle.Gram.Regular.Simple"/>
        <LinearLayout
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:id="@+id/emailFieldGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                android:textStyle="normal"
                android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                android:id="@+id/emailLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/emailText"
                android:textColor="@color/text_color_main" />

            <LinearLayout
                android:id="@+id/emailBox"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:background="@drawable/bg_input_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/email_icon" />

                <EditText
                    android:textCursorDrawable="@null"
                    android:textColorHighlight="@color/text_color_main"
                    android:textColorLink="@color/text_color_main"
                    android:textColor="@color/text_color_main"
                    android:id="@+id/newEmailInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/emailText"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:paddingStart="18dp"
                    android:paddingEnd="8dp"
                    android:textColorHint="@color/text_color_secondary"
                    android:textSize="18sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/emailError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/red"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:id="@+id/passwordFieldGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                android:textStyle="normal"
                android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                android:id="@+id/passwordLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/passwordText"
                android:textColor="@color/text_color_main"/>

            <LinearLayout
                android:id="@+id/passwordBox"
                android:layout_width="match_parent"
                android:layout_height="68dp"
                android:background="@drawable/bg_input_box"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:contentDescription="@null"
                    android:src="@drawable/password_icon" />

                <com.google.android.material.textfield.TextInputLayout
                    android:paddingStart="18dp"
                    android:paddingEnd="0dp"
                    android:id="@+id/passwordInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    app:endIconMode="password_toggle"
                    app:boxStrokeColor="@color/text_color_main"
                    android:background="@android:color/transparent"
                    app:endIconTint="@color/text_color_secondary"
                    app:boxBackgroundMode="none"
                    app:boxStrokeWidth="0dp"
                    app:boxStrokeWidthFocused="0dp"
                    app:hintEnabled="false">

                    <com.google.android.material.textfield.TextInputEditText
                        android:textCursorDrawable="@null"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        android:id="@+id/currentPasswordEmailInput"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="@string/password_hint_full"
                        android:background="@null"
                        android:inputType="textPassword"
                        android:singleLine="true"
                        android:textColor="@color/text_color_main"
                        android:textColorHint="@color/text_color_secondary"
                        android:textSize="18sp" />

                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/passwordError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/red"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="40dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <ProgressBar
                android:id="@+id/emailProgress"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:visibility="gone"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:indeterminateTint="@color/red"/>

            <LinearLayout
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:id="@+id/emailButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:weightSum="2"
                android:orientation="horizontal">
                <Button
                    android:maxHeight="30dp"
                    android:textAllCaps="true"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextStyle.GoodTiming.Regular"
                    android:textSize="14sp"
                    android:textColor="@color/dark_grey"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/cancelEmailButton"
                    android:text="@string/cancel"
                    style="@style/declineButtonStyle"/>
                <Button
                    android:layout_weight="1"
                    android:textAppearance="@style/TextStyle.GoodTiming.Bold"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:layout_width="0dp"
                    android:layout_marginStart="5dp"
                    android:layout_height="wrap_content"
                    android:id="@+id/saveEmailButton"
                    android:text="@string/save_text"
                    android:textAllCaps="true"
                    android:backgroundTint="@color/red"
                    style="@style/ButtonStyle"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>