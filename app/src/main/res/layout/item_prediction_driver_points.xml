<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:minHeight="40dp" android:paddingTop="6dp" android:paddingBottom="6dp">
    <TextView android:id="@+id/dpRowLabel" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:layout_marginEnd="8dp"
        android:textColor="@color/text_color_main" android:textSize="14sp"/>
    <TextView android:id="@+id/dpRowA" android:layout_width="64dp" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="@color/text_color_main" android:textSize="15sp" android:textStyle="bold"/>
    <TextView android:id="@+id/dpRowB" android:layout_width="64dp" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="@color/text_color_main" android:textSize="15sp" android:textStyle="bold"/>
</LinearLayout>