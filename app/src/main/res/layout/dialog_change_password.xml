<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/colorPrimary"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardCornerRadius="15dp"
    app:cardElevation="15dp">
    <LinearLayout
        android:paddingTop="30dp"
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <TextView
            android:id="@+id/dialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:gravity="center"
            android:text="@string/change_password"
            android:textAllCaps="true"
            android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
            android:textColor="@color/text_color_main"
            android:textSize="21sp"
            android:textStyle="bold" />
        <TextView
            android:layout_marginBottom="10dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:id="@+id/dialogDescription"
            android:layout_marginTop="13dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/grey"
            android:text="@string/dialog_change_password_description"
            android:textAppearance="@style/TextStyle.Gram.Regular.Simple"/>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_marginBottom="8dp"
            android:id="@+id/currentPasswordLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:hint="@string/current_password"
            android:theme="@style/StyledTilEditTextTheme"
            app:endIconMode="password_toggle"
            app:errorEnabled="true"
            app:errorTextAppearance="@style/TextStyle.Gram.Regular.Simple"
            app:errorTextColor="@color/red"
            app:hintEnabled="true"
            app:hintTextAppearance="@style/TextStyle.Gram.Regular.Simple"
            app:hintTextColor="@color/text_color_main">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/currentPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/text_color_main"
                android:inputType="textPassword"
                android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                android:theme="@style/StyledTilEditTextTheme" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_marginBottom="8dp"
            android:id="@+id/newPasswordLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:hint="@string/new_password"
            android:theme="@style/StyledTilEditTextTheme"
            app:endIconMode="password_toggle"
            app:errorEnabled="true"
            app:errorTextAppearance="@style/TextStyle.Gram.Regular.Simple"
            app:errorTextColor="@color/red"
            app:hintEnabled="true"
            app:hintTextAppearance="@style/TextStyle.Gram.Regular.Simple"
            app:hintTextColor="@color/text_color_main">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/newPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/text_color_main"
                android:inputType="textPassword"
                android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                android:theme="@style/StyledTilEditTextTheme" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_marginBottom="8dp"
            android:id="@+id/repeatPasswordLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:hint="@string/repeat_password"
            android:theme="@style/StyledTilEditTextTheme"
            app:endIconMode="password_toggle"
            app:errorEnabled="true"
            app:errorTextAppearance="@style/TextStyle.Gram.Regular.Simple"
            app:errorTextColor="@color/red"
            app:hintEnabled="true"
            app:hintTextAppearance="@style/TextStyle.Gram.Regular.Simple"
            app:hintTextColor="@color/text_color_main">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/repeatPasswordInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/text_color_main"
                android:inputType="textPassword"
                android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                android:theme="@style/StyledTilEditTextTheme" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/passwordProgress"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:indeterminateTint="@color/red"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/passwordButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/cancelPasswordButton"
                    style="@style/declineButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:maxHeight="30dp"
                    android:text="@string/cancel"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextStyle.GoodTiming.Regular"
                    android:textColor="@color/dark_grey"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/savePasswordButton"
                    style="@style/ButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/red"
                    android:text="@string/save_text"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextStyle.GoodTiming.Bold"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>