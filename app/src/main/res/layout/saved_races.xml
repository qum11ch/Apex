<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@+id/saved_races_root"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">

    <LinearLayout
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="16dp"
        android:id="@+id/header"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/header_color">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/back_arrow"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:src="@drawable/back_arrow" />

        <TextView
            android:layout_gravity="center"
            android:textAllCaps="true"
            android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/saved_race"
            android:textColor="@color/white"
            android:textSize="22sp"/>

        <!-- Takes the place of the old 48dp spacer, so the title stays centered. -->
        <ImageButton
            android:id="@+id/view_mode_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/saved_races_view_as_tiles"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_view_mode_tiles" />
    </LinearLayout>

    <View
        android:layout_below="@id/header"
        android:id="@+id/separatorLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/separator_header" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/header"
        android:layout_alignParentBottom="true">

        <!-- Horizontal system insets are added to this container's padding in code. -->
        <FrameLayout
            android:id="@+id/saved_stage"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 5dp container padding + 5dp item margin = the 10dp edge used before. -->
            <FrameLayout
                android:id="@+id/saved_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="5dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerview_savedRaces"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    android:overScrollMode="never"
                    android:clipToPadding="false"
                    android:paddingBottom="24dp" />

                <com.facebook.shimmer.ShimmerFrameLayout
                    android:id="@+id/shimmer_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:duration="1500">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:id="@+id/skeleton_rows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <include layout="@layout/shimmer_saved_race" />
                            <include layout="@layout/shimmer_saved_race" />
                            <include layout="@layout/shimmer_saved_race" />
                            <include layout="@layout/shimmer_saved_race" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/skeleton_tiles"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">
                            <include layout="@layout/shimmer_saved_race_tile" />
                            <include layout="@layout/shimmer_saved_race_tile" />
                            <include layout="@layout/shimmer_saved_race_tile" />
                        </LinearLayout>
                    </FrameLayout>

                </com.facebook.shimmer.ShimmerFrameLayout>

                <LinearLayout
                    android:id="@+id/state_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="48dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">
                    <TextView
                        android:id="@+id/state_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                        android:textColor="@color/text_color_secondary"
                        android:textSize="16sp" />
                    <Button
                        android:id="@+id/state_retry"
                        style="@style/ButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:minWidth="160dp"
                        android:text="@string/saved_races_retry" />
                </LinearLayout>
            </FrameLayout>

            <androidx.core.widget.NestedScrollView
                android:id="@+id/emptySavedRaceScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:visibility="gone">
                <RelativeLayout
                    android:id="@+id/emptySavedRace_layout"
                    style="@style/SavedRacesLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    android:minHeight="200dp"
                    android:layout_marginEnd="10dp"
                    android:visibility="visible">
                    <RelativeLayout
                        android:orientation="vertical"
                        android:id="@+id/team"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="200dp"
                        android:paddingBottom="16dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="5dp">
                        <com.google.android.material.imageview.ShapeableImageView
                            style="@style/StripedLinesWhite"
                            app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.CornerCircle"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:id="@+id/stripedImage"/>
                        <TextView
                            android:textColor="@color/text_color_schedule"
                            android:paddingStart="10dp"
                            android:paddingEnd="0dp"
                            android:paddingTop="20dp"
                            android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                            android:textSize="28sp"
                            android:layout_marginEnd="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/empty_race_list_header"
                            android:id="@+id/header_text"/>
                        <TextView
                            android:textColor="@color/text_color_schedule"
                            android:layout_below="@id/header_text"
                            android:paddingStart="10dp"
                            android:paddingEnd="0dp"
                            android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                            android:textStyle="bold"
                            android:layout_marginTop="10dp"
                            android:layout_marginEnd="10dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/empty_saved_race_info"/>
                    </RelativeLayout>
                </RelativeLayout>
            </androidx.core.widget.NestedScrollView>
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</RelativeLayout>
