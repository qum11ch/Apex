<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@+id/account_root"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">
    <ProgressBar
        android:id="@+id/loadingBar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:indeterminateTint="@color/progressBarColor"
        android:indeterminateTintMode="src_atop"
        android:visibility="visible" />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_content"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <RelativeLayout
                android:id="@+id/account_header_container"
                android:layout_width="match_parent"
                android:layout_height="220dp">
                <RelativeLayout
                    android:paddingTop="16dp"
                    android:background="@color/account_settings_header_color"
                    android:id="@+id/header"
                    android:layout_width="match_parent"
                    android:layout_height="200dp">
                    <ImageButton
                        android:layout_alignParentStart="true"
                        android:id="@+id/backButton"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/back_arrow"
                        android:src="@drawable/back_arrow" />
                    <ImageButton
                        android:layout_alignParentEnd="true"
                        android:id="@+id/settings_button"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/settings"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:src="@drawable/settings" />
                </RelativeLayout>

                <androidx.cardview.widget.CardView
                    android:id="@+id/avatarCard"
                    android:layout_marginStart="20dp"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    android:layout_alignParentBottom="true"
                    android:layout_alignParentStart="true">
                    <com.google.android.material.imageview.ShapeableImageView
                        app:shapeAppearanceOverlay="@style/customRoundedImageView.Avatar"
                        android:layout_gravity="center"
                        android:id="@+id/avatarImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        app:strokeWidth="2dp"
                        app:strokeColor="@color/text_color_thirdly"/>
                    <TextView
                        android:layout_gravity="center"
                        android:background="@android:color/transparent"
                        android:id="@+id/avatarInitial"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/text_color_secondary"
                        android:textSize="38sp"
                        android:textStyle="bold" />
                </androidx.cardview.widget.CardView>
            </RelativeLayout>
            <androidx.core.widget.NestedScrollView
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:id="@+id/nestedScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/colorPrimary"
                android:clipToPadding="false"
                android:paddingBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_marginTop="10dp"
                        android:layout_marginStart="13dp"
                        android:minHeight="40dp"
                        android:id="@+id/username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_color_main"
                        android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader" />

                    <TextView
                        android:layout_marginStart="13dp"
                        android:minHeight="30dp"
                        android:id="@+id/createdAt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/created_at_text"
                        android:textColor="@color/grey"
                        android:textSize="14sp"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Simple" />

                    <LinearLayout
                        android:layout_marginTop="20dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="70dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:weightSum="3">
                        <LinearLayout
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="70dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:orientation="vertical"
                            style="@style/ItemStylePreds"
                            android:gravity="center"
                            android:layout_marginEnd="5dp">
                            <TextView
                                android:id="@+id/prediction_count"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_color_main"
                                android:textAlignment="center"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                                android:text="0"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/predictions_text_lowered"
                                android:textSize="14sp"
                                android:textColor="@color/grey"
                                android:textAlignment="center"
                                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_height="wrap_content"
                            android:minHeight="70dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:orientation="vertical"
                            style="@style/ItemStylePreds"
                            android:gravity="center"
                            android:layout_marginStart="5dp"
                            android:layout_marginEnd="5dp">
                            <TextView
                                android:id="@+id/points_earned"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_color_main"
                                android:textAlignment="center"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                                android:text="0"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/points_text_lowered"
                                android:textSize="14sp"
                                android:textColor="@color/grey"
                                android:textAlignment="center"
                                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"/>
                        </LinearLayout>
                        <LinearLayout
                            android:layout_height="wrap_content"
                            android:minHeight="70dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:orientation="vertical"
                            style="@style/ItemStylePreds"
                            android:gravity="center"
                            android:layout_marginStart="5dp">
                            <TextView
                                android:id="@+id/races_saved"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_color_main"
                                android:textAlignment="center"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                                android:text="0"/>
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/races_saved_text_lowered"
                                android:textSize="14sp"
                                android:textColor="@color/grey"
                                android:textAlignment="center"
                                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_marginTop="15dp"
                        android:gravity="bottom"
                        android:textSize="18sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/account_fav_text"
                        android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:weightSum="2">
                        <RelativeLayout
                            android:minHeight="76dp"
                            android:id="@+id/userFavTeam_layout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp">
                            <RelativeLayout
                                android:id="@+id/favTeam_header_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp">

                                <ImageButton
                                    android:id="@+id/editTeam"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:padding="5dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:src="@drawable/ic_edit"
                                    app:tint="?android:attr/textColorPrimary" />

                                <TextView
                                    android:id="@+id/favTeam_header"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:minHeight="48dp"
                                    android:layout_toStartOf="@id/editTeam"
                                    android:layout_centerVertical="true"
                                    android:paddingStart="4dp"
                                    android:paddingEnd="4dp"
                                    android:paddingTop="8dp"
                                    android:paddingBottom="8dp"
                                    android:gravity="center"
                                    android:text="@string/favourite_team"
                                    android:textStyle="bold"
                                    android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"
                                    android:textSize="16sp" />

                            </RelativeLayout>
                            <RelativeLayout
                                style="@style/ItemStylePreds"
                                android:id="@+id/team_layout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/favTeam_header_row"
                                android:padding="8dp">

                                <RelativeLayout
                                    android:id="@+id/teamPhoto"
                                    android:layout_width="match_parent"
                                    android:layout_height="130dp"
                                    style="@style/ItemStylePreds"
                                    android:backgroundTint="@color/colorPrimary">
                                    <ImageView
                                        android:id="@+id/teamCar"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_margin="6dp"
                                        android:contentDescription="@string/team_car"
                                        android:scaleType="fitCenter"
                                        android:visibility="invisible" />
                                    <TextView
                                        android:text="+"
                                        android:textStyle="normal"
                                        android:textSize="48sp"
                                        android:textColor="@color/grey"
                                        android:id="@+id/noTeam"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_centerInParent="true"
                                        android:layout_marginStart="8dp"
                                        android:layout_marginEnd="8dp"
                                        android:gravity="center"
                                        android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                                        android:visibility="invisible" />
                                </RelativeLayout>

                                <RelativeLayout
                                    android:minHeight="76dp"
                                    android:id="@+id/teamName_layout"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@id/teamPhoto"
                                    android:paddingTop="10dp"
                                    android:paddingBottom="4dp">
                                    <TextView
                                        android:gravity="center"
                                        android:textAlignment="center"
                                        android:id="@+id/teamName"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_centerInParent="true"
                                        android:textStyle="bold"
                                        android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForNames" />
                                </RelativeLayout>
                            </RelativeLayout>
                        </RelativeLayout>

                        <!-- Гонщик -->
                        <RelativeLayout
                            android:id="@+id/userFavDriver_layout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp">
                            <RelativeLayout
                                android:id="@+id/favDriver_header_row"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minHeight="48dp">

                                <ImageButton
                                    android:id="@+id/editDriver"
                                    android:layout_width="48dp"
                                    android:layout_height="48dp"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true"
                                    android:padding="5dp"
                                    android:background="?attr/selectableItemBackgroundBorderless"
                                    android:src="@drawable/ic_edit"
                                    app:tint="?android:attr/textColorPrimary" />

                                <TextView
                                    android:id="@+id/favTeam_driver"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:minHeight="48dp"
                                    android:layout_toStartOf="@id/editDriver"
                                    android:layout_centerVertical="true"
                                    android:paddingStart="4dp"
                                    android:paddingEnd="4dp"
                                    android:paddingTop="8dp"
                                    android:paddingBottom="8dp"
                                    android:gravity="center"
                                    android:text="@string/favourite_driver"
                                    android:textStyle="bold"
                                    android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"
                                    android:textSize="16sp" />

                            </RelativeLayout>
                            <RelativeLayout
                                android:id="@+id/driver_layout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/favDriver_header_row"
                                android:padding="8dp"
                                style="@style/ItemStylePreds">

                                <RelativeLayout
                                    android:id="@+id/driverPhoto"
                                    android:layout_width="match_parent"
                                    android:layout_height="130dp"
                                    style="@style/ItemStylePreds"
                                    android:backgroundTint="@color/colorPrimary">
                                    <ImageView
                                        android:id="@+id/driver_image"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:contentDescription="@string/driverimage"
                                        android:scaleType="fitCenter" />
                                    <TextView
                                        android:id="@+id/noDriver"
                                        android:text="+"
                                        android:textSize="48sp"
                                        android:textStyle="normal"
                                        android:textColor="@color/grey"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_centerInParent="true"
                                        android:layout_marginStart="8dp"
                                        android:layout_marginEnd="8dp"
                                        android:gravity="center"
                                        android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                                        android:visibility="invisible" />
                                </RelativeLayout>

                                <LinearLayout
                                    android:id="@+id/driverName_layout"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@id/driverPhoto"
                                    android:gravity="center"
                                    android:minHeight="76dp"
                                    android:orientation="vertical"
                                    android:paddingTop="10dp"
                                    android:paddingBottom="4dp">
                                    <TextView
                                        android:id="@+id/driverName"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textAlignment="center"
                                        android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForNames" />
                                    <TextView
                                        android:id="@+id/driverFamilyName"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:textAlignment="center"
                                        android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader" />
                                </LinearLayout>
                            </RelativeLayout>
                        </RelativeLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/button_layout1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="28dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:weightSum="2">

                        <Button
                            android:id="@+id/userPredictions"
                            style="@style/ButtonStyleAccountPage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="100dp"
                            android:layout_marginEnd="5dp"
                            android:layout_weight="1"
                            android:drawableTop="@drawable/prediction"
                            android:drawablePadding="8dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:text="@string/user_prediction_button_text"
                            android:textAlignment="center"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Simple" />

                        <Button
                            android:id="@+id/savedRace"
                            style="@style/ButtonStyleAccountPage"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="100dp"
                            android:layout_marginStart="5dp"
                            android:layout_weight="1"
                            android:drawableTop="@drawable/saved"
                            android:drawablePadding="8dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:text="@string/saved_race"
                            android:textAlignment="center"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Simple" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/logout"
                        android:background="@android:color/transparent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="16dp"
                        android:minWidth="160dp"
                        android:textAlignment="center"
                        android:text="@string/logout"
                        android:textColor="@color/logout_button_color"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Simple" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</RelativeLayout>