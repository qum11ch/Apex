<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">
    <ProgressBar
        android:visibility="visible"
        android:id="@+id/loadingBar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:indeterminateTint="@color/progressBarColor"
        android:indeterminateTintMode="src_atop" />
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fitsSystemWindows="true"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:statusBarScrim="@android:color/transparent">

            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsing_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="40dp"
                android:background="@drawable/blue_gradient"
                android:fitsSystemWindows="true"
                app:layout_scrollFlags="scroll|snap|exitUntilCollapsed"
                app:statusBarScrim="@color/statusBar_color">

                <RelativeLayout
                    android:id="@+id/content_header_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="70dp"
                    android:paddingStart="30dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp"
                    app:layout_collapseMode="parallax">

                    <FrameLayout
                        android:id="@+id/avatar"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/avatar_bg">

                        <ImageView
                            android:id="@+id/avatarImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/profile_avatar"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/avatarInitial"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="26sp"
                            android:textStyle="bold"
                            android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader" />

                    </FrameLayout>

                    <TextView
                        android:id="@+id/username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/avatar"
                        android:layout_alignTop="@id/avatar"
                        android:layout_marginStart="16dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/white"
                        android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader" />

                    <TextView
                        android:id="@+id/createdAt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/username"
                        android:layout_toEndOf="@id/avatar"
                        android:layout_marginStart="16dp"
                        android:layout_marginTop="4dp"
                        android:text="@string/created_at_text"
                        android:textColor="#B8C0D0"
                        android:textSize="14sp"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Simple" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/avatar"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <TextView android:id="@+id/driverNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        <TextView android:id="@+id/userFavDriver"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                        <ImageView android:id="@+id/team_logo"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:contentDescription="@string/team_logo" />
                        <TextView android:id="@+id/userFavTeam"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </RelativeLayout>

                <androidx.appcompat.widget.Toolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:background="@android:color/transparent"
                    android:fitsSystemWindows="true"
                    app:contentInsetLeft="0dp"
                    app:contentInsetStart="0dp"
                    app:layout_collapseMode="pin">
                    <RelativeLayout
                        android:id="@+id/header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageButton
                            android:id="@+id/backButton"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/back_arrow"
                            android:paddingStart="15dp"
                            android:paddingEnd="15dp"
                            android:src="@drawable/back_arrow" />
                        <TextView
                            android:id="@+id/tabUserName"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_toStartOf="@id/settings_button"
                            android:layout_toEndOf="@id/backButton"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader" />
                        <ImageButton
                            android:id="@+id/settings_button"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_alignParentEnd="true"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/settings"
                            android:paddingStart="15dp"
                            android:paddingEnd="15dp"
                            android:src="@drawable/settings" />
                    </RelativeLayout>
                </androidx.appcompat.widget.Toolbar>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorPrimary"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="16dp"
            app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_marginTop="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:orientation="horizontal"
                    android:weightSum="3">
                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        style="@style/ItemStylePreds"
                        android:gravity="center"
                        android:layout_marginEnd="5dp">
                        <TextView
                            android:id="@+id/prediction_count"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_color_main"
                            android:textAlignment="center"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                            android:text="0"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/predictions_text_lowered"
                            android:textSize="14sp"
                            android:textColor="@color/grey"
                            android:textAlignment="center"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Simple"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        style="@style/ItemStylePreds"
                        android:gravity="center"
                        android:layout_marginStart="5dp"
                        android:layout_marginEnd="5dp">
                        <TextView
                            android:id="@+id/points_earned"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_color_main"
                            android:textAlignment="center"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                            android:text="0"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/points_text_lowered"
                            android:textSize="14sp"
                            android:textColor="@color/grey"
                            android:textAlignment="center"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Simple"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        style="@style/ItemStylePreds"
                        android:gravity="center"
                        android:layout_marginStart="5dp">
                        <TextView
                            android:id="@+id/races_saved"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_color_main"
                            android:textAlignment="center"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                            android:text="0"/>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/races_saved_text_lowered"
                            android:textSize="14sp"
                            android:textColor="@color/grey"
                            android:textAlignment="center"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Simple"/>
                    </LinearLayout>
                </LinearLayout>
                
                <TextView
                    android:layout_marginTop="15dp"
                    android:gravity="bottom"
                    android:textSize="18sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/account_fav_text"
                    android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:weightSum="2">
                    <RelativeLayout
                        android:minHeight="76dp"
                        android:id="@+id/userFavTeam_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp">
                        <RelativeLayout
                            android:id="@+id/favTeam_header_row"
                            android:layout_width="match_parent"
                            android:layout_height="48dp">
                            <ImageButton
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:padding="5dp"
                                android:id="@+id/editTeam"
                                android:layout_alignParentEnd="true"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:layout_centerVertical="true"
                                android:src="@drawable/ic_edit"
                                app:tint="?android:attr/textColorPrimary" />
                            <TextView
                                android:id="@+id/favTeam_header"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_toStartOf="@id/editTeam"
                                android:paddingStart="15dp"
                                android:paddingEnd="0dp"
                                android:gravity="center"
                                android:text="@string/favourite_team"
                                android:textStyle="bold"
                                android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"
                                android:textSize="16sp"/>
                        </RelativeLayout>
                        <RelativeLayout
                            style="@style/ItemStylePreds"
                            android:id="@+id/team_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/favTeam_header_row"
                            android:layout_marginTop="8dp"
                            android:padding="8dp">

                            <RelativeLayout
                                android:id="@+id/teamPhoto"
                                android:layout_width="match_parent"
                                android:layout_height="130dp"
                                style="@style/ItemStylePreds"
                                android:backgroundTint="@color/colorPrimary">
                                <ImageView
                                    android:id="@+id/teamCar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:layout_margin="6dp"
                                    android:contentDescription="@string/team_car"
                                    android:scaleType="fitCenter"
                                    android:visibility="invisible" />
                                <TextView
                                    android:text="+"
                                    android:textStyle="normal"
                                    android:textSize="48sp"
                                    android:textColor="@color/grey"
                                    android:id="@+id/noTeam"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_centerInParent="true"
                                    android:layout_marginStart="8dp"
                                    android:layout_marginEnd="8dp"
                                    android:gravity="center"
                                    android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                                    android:visibility="invisible" />
                            </RelativeLayout>

                            <RelativeLayout
                                android:minHeight="76dp"
                                android:id="@+id/teamName_layout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/teamPhoto"
                                android:paddingTop="10dp"
                                android:paddingBottom="4dp">
                                <TextView
                                    android:gravity="center"
                                    android:textAlignment="center"
                                    android:id="@+id/teamName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerInParent="true"
                                    android:textStyle="bold"
                                    android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForNames" />
                                </RelativeLayout>
                        </RelativeLayout>
                    </RelativeLayout>

                    <!-- Гонщик -->
                    <RelativeLayout
                        android:id="@+id/userFavDriver_layout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">
                        <RelativeLayout
                            android:id="@+id/favDriver_header_row"
                            android:layout_width="match_parent"
                            android:layout_height="48dp">
                            <ImageButton
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:padding="5dp"
                                android:layout_centerVertical="true"
                                android:id="@+id/editDriver"
                                android:layout_alignParentEnd="true"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@drawable/ic_edit"
                                app:tint="?android:attr/textColorPrimary" />
                            <TextView
                                android:paddingStart="20dp"
                                android:paddingEnd="0dp"
                                android:gravity="center"
                                android:id="@+id/favTeam_driver"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_toStartOf="@id/editDriver"
                                android:text="@string/favourite_driver"
                                android:textStyle="bold"
                                android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"
                                android:textSize="16sp"
                                tools:ignore="RtlCompat" />
                        </RelativeLayout>
                        <RelativeLayout
                            android:id="@+id/driver_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/favDriver_header_row"
                            android:layout_marginTop="8dp"
                            android:padding="8dp"
                            style="@style/ItemStylePreds">

                            <RelativeLayout
                                android:id="@+id/driverPhoto"
                                android:layout_width="match_parent"
                                android:layout_height="130dp"
                                style="@style/ItemStylePreds"
                                android:backgroundTint="@color/colorPrimary">
                                <ImageView
                                    android:id="@+id/driver_image"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/driverimage"
                                    android:scaleType="fitCenter" />
                                <TextView
                                    android:id="@+id/noDriver"
                                    android:text="+"
                                    android:textSize="48sp"
                                    android:textStyle="normal"
                                    android:textColor="@color/grey"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_centerInParent="true"
                                    android:layout_marginStart="8dp"
                                    android:layout_marginEnd="8dp"
                                    android:gravity="center"
                                    android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                                    android:visibility="invisible" />
                            </RelativeLayout>

                            <LinearLayout
                                android:id="@+id/driverName_layout"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/driverPhoto"
                                android:gravity="center"
                                android:minHeight="76dp"
                                android:orientation="vertical"
                                android:paddingTop="10dp"
                                android:paddingBottom="4dp">
                                <TextView
                                    android:id="@+id/driverName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAlignment="center"
                                    android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForNames" />
                                <TextView
                                    android:id="@+id/driverFamilyName"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textAlignment="center"
                                    android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader" />
                            </LinearLayout>
                        </RelativeLayout>
                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/button_layout1"
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:layout_marginTop="28dp"
                    android:orientation="horizontal"
                    android:weightSum="2">
                    <Button
                        android:id="@+id/userPredictions"
                        style="@style/ButtonStyleAccountPage"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:drawableTop="@drawable/prediction"
                        android:drawablePadding="-20dp"
                        android:paddingTop="20dp"
                        android:textColor="@color/white"
                        android:text="@string/user_prediction_button_text"
                        android:textAlignment="center"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Simple" />
                    <Button

                        android:textColor="@color/white"
                        android:id="@+id/savedRace"
                        style="@style/ButtonStyleAccountPage"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:drawableTop="@drawable/saved"
                        android:drawablePadding="-20dp"
                        android:paddingTop="20dp"
                        android:text="@string/saved_race"
                        android:textAlignment="center"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Simple" />
                </LinearLayout>

                <Button
                    android:id="@+id/logout"
                    android:background="@android:color/transparent"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="16dp"
                    android:minWidth="160dp"
                    android:text="@string/logout"
                    android:textColor="@color/logout_button_color"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textAppearance="@style/TextStyle.Gram.Regular.Simple" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
</RelativeLayout>