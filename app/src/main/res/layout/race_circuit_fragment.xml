<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:overScrollMode="never"
    android:background="@color/colorPrimary"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/scrollView"
    android:fillViewport="true"
    android:scrollbars="none">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/content_layout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp">
            <RelativeLayout
                android:id="@+id/race_info_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:minHeight="75dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/flagLayout"
                    android:layout_width="100dp"
                    android:layout_height="75dp"
                    app:cardBackgroundColor="@color/colorPrimary"
                    app:cardElevation="0dp"
                    app:cardPreventCornerOverlap="true">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/flag"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="fitCenter"
                        android:padding="0.5dp"
                        app:shapeAppearanceOverlay="@style/customRoundedImageView"
                        app:strokeColor="@color/grey"
                        app:strokeWidth="0.5dp" />

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/raceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/flagLayout"
                    android:layout_marginStart="10dp"
                    android:textStyle="bold"
                    android:textAllCaps="true"
                    android:textColor="@color/text_color_main"
                    android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader" />

                <TextView
                    android:id="@+id/circuitName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/flagLayout"
                    android:layout_below="@id/raceName"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="3dp"
                    android:textStyle="normal"
                    android:textColor="@color/text_color_main"
                    android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo" />

            </RelativeLayout>
            <androidx.cardview.widget.CardView
                android:id="@+id/circuit_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/race_info_layout"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                app:cardBackgroundColor="@color/account_settings_input_color"
                app:cardCornerRadius="15dp"
                app:cardElevation="0dp"
                app:cardPreventCornerOverlap="true">

                <ImageView
                    android:layout_margin="5dp"
                    android:id="@+id/circuitImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/flag_image" />
            </androidx.cardview.widget.CardView>
            <RelativeLayout
                android:id="@+id/circuitInfo_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/circuit_card">
                <LinearLayout
                    android:id="@+id/length_layout"
                    style="@style/CircuitLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical"
                    android:paddingTop="20dp"
                    android:paddingBottom="8dp">

                    <TextView
                        android:id="@+id/length_info"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:text="@string/circuit_length"
                        android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo" />

                    <TextView
                        android:id="@+id/length"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:textColor="@color/text_color_main"
                        android:textAppearance="@style/TextStyle.Audiowide.ForCountdown" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="2dp"
                        android:text="@string/kilometres"
                        android:textAllCaps="true"
                        android:textColor="@color/text_color_main"
                        android:textSize="15sp"
                        android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader" />

                </LinearLayout>
                <LinearLayout
                    android:id="@+id/circuitInfo_1"
                    android:baselineAligned="false"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_below="@id/length_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="2"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">
                    <LinearLayout
                        style="@style/CircuitInfoLayout"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginEnd="5dp"
                        android:paddingBottom="5dp">
                        <TextView
                            android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/no_of_laps"/>
                        <TextView
                            android:id="@+id/lapsNum"
                            android:textColor="@color/text_color_main"
                            android:textAppearance="@style/TextStyle.Audiowide.ForCountdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                    <LinearLayout
                        android:paddingBottom="5dp"
                        style="@style/CircuitInfoLayout"
                        android:layout_weight="1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="5dp">
                        <TextView
                            android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/first_grand_prix"/>
                        <TextView
                            android:id="@+id/firstGP"
                            android:textColor="@color/text_color_main"
                            android:textAppearance="@style/TextStyle.Audiowide.ForCountdown"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""/>
                    </LinearLayout>
                </LinearLayout>
                <RelativeLayout
                    android:paddingBottom="5dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    style="@style/CircuitInfoLayout"
                    android:layout_below="@id/circuitInfo_1"
                    android:id="@+id/circuitInfo_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">
                    <TextView
                        android:id="@+id/raceDist_info"
                        android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/race_distance"/>
                    <TextView
                        android:layout_below="@id/raceDist_info"
                        android:id="@+id/raceDist"
                        android:textColor="@color/text_color_main"
                        android:textAppearance="@style/TextStyle.Audiowide.ForCountdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:layout_marginStart="10dp"
                        android:layout_toEndOf="@id/raceDist"
                        android:gravity="bottom"
                        android:layout_below="@id/raceDist_info"
                        android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"
                        android:textSize="15sp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAllCaps="true"
                        android:text="@string/kilometres"/>
                </RelativeLayout>
                <LinearLayout
                    android:paddingBottom="5dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:orientation="vertical"
                    style="@style/CircuitInfoLayout"
                    android:layout_below="@id/circuitInfo_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">
                    <TextView
                        android:id="@+id/lapRecord_info"
                        android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/lap_record"/>
                    <TextView
                        android:id="@+id/lapRecord_time"
                        android:textColor="@color/text_color_main"
                        android:textAppearance="@style/TextStyle.Audiowide.ForCountdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""/>
                    <TextView
                        android:layout_marginTop="3dp"
                        android:id="@+id/lapRecord_driver"
                        android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:paddingBottom="5dp"/>
                </LinearLayout>
            </RelativeLayout>
            <Button
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:backgroundTint="@color/colorThirdly"
                android:textColor="@color/text_color_main"
                android:layout_marginTop="20dp"
                android:layout_below="@id/circuitInfo_layout"
                android:textSize="18sp"
                style="@style/FlatButtonStyle"
                android:textAlignment="textStart"
                android:paddingStart="20dp"
                android:paddingEnd="5dp"
                android:layout_width="match_parent"
                android:textAppearance="@style/TextStyle.Gram.Bold"
                android:id="@+id/raceResults_2025"
                android:layout_marginEnd="10dp"/>
            <View
                android:layout_below="@id/raceResults_2025"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginEnd="10dp"
                android:background="@color/grey"
                android:id="@+id/resultsLine"/>
            <Button
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:backgroundTint="@color/colorThirdly"
                android:textColor="@color/text_color_main"
                android:layout_marginBottom="30dp"
                android:layout_below="@id/resultsLine"
                style="@style/PrevResultsStyleButtom"
                android:textSize="18sp"
                android:textAlignment="textStart"
                android:paddingStart="20dp"
                android:paddingEnd="5dp"
                android:layout_width="match_parent"
                android:textAppearance="@style/TextStyle.Gram.Bold"
                android:id="@+id/raceResults_2024"
                android:layout_marginEnd="10dp"/>
        </RelativeLayout>
        <com.facebook.shimmer.ShimmerFrameLayout
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/shimmer_layout">
            <include layout="@layout/shimmer_race_circuit_fragment"/>
        </com.facebook.shimmer.ShimmerFrameLayout>
    </RelativeLayout>
</ScrollView>
