<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmer_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible">
            <include layout="@layout/shimmer_race_circuit_fragment" />
        </com.facebook.shimmer.ShimmerFrameLayout>

        <LinearLayout
            android:id="@+id/content_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="20dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="1dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/flag"
                    android:layout_width="72dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/customRoundedImageView"
                    app:strokeColor="@color/grey"
                    app:strokeWidth="0.5dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/raceName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textAppearance="@style/TextStyle.GoodTiming.Bold"
                        android:textColor="@color/text_color_main"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/circuitName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:includeFontPadding="false"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                        android:textColor="@color/grey"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_results_card"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/circuitImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/flag_image"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/circuit_stats_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_results_card"
                android:divider="@drawable/divider_results"
                android:orientation="vertical"
                android:showDividers="middle">

                <LinearLayout
                    android:id="@+id/stats_top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:divider="@drawable/divider_results"
                    android:orientation="horizontal"
                    android:showDividers="middle" />

                <LinearLayout
                    android:id="@+id/stats_bottom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:divider="@drawable/divider_results"
                    android:orientation="horizontal"
                    android:showDividers="middle" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/lap_record"
                            android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                            android:textColor="@color/grey"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/lapRecord_time"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:includeFontPadding="false"
                            android:textAppearance="@style/TextStyle.Audiowide.ForPTS"
                            android:textColor="@color/text_color_main"
                            android:textSize="22sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/lapRecord_driver"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:includeFontPadding="false"
                        android:maxLines="2"
                        android:textAppearance="@style/TextStyle.GoodTiming.Regular"
                        android:textColor="@color/text_color_main"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/raceResults_history"
                style="@style/FlatButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_results_card"
                android:drawableEnd="@drawable/ic_chevron_right_small"
                android:drawableTint="@color/text_color_main"
                android:gravity="center_vertical|start"
                android:minHeight="60dp"
                android:paddingStart="16dp"
                android:paddingEnd="14dp"
                android:textAllCaps="false"
                android:textAppearance="@style/TextStyle.Gram.Bold"
                android:textColor="@color/text_color_main"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </RelativeLayout>
</ScrollView>
