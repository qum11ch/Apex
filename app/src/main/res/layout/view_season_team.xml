<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_podium_card"
    android:clickable="true"
    android:clipToOutline="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal">

    <View
        android:id="@+id/seasonBar"
        android:layout_width="5dp"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/seasonPlace"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextStyle.Audiowide.ForDays"
        android:textColor="@color/hero_text_secondary"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/seasonName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/hero_text"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/seasonPoints"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/hero_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/seasonBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.04"
            android:textAllCaps="true"
            android:textColor="@color/podium_gold"
            android:textSize="10sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/seasonCar"
        android:layout_width="128dp"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />
</LinearLayout>