<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/bhHeading" style="@style/Widget.Apex.Pred.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bh_title" />
    <TextView android:id="@+id/bhMessage" style="@style/Widget.Apex.Pred.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" />
    <LinearLayout android:id="@+id/bhStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/bhRatio" style="@style/Widget.Apex.Pred.Big" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/bhCaption" style="@style/Widget.Apex.Pred.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/bhUnknown" style="@style/Widget.Apex.Pred.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/bhVirtual" style="@style/Widget.Apex.Pred.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="16dp" android:layout_marginBottom="12dp" android:alpha="0.12" android:background="@color/text_color_main" />
        <TextView style="@style/Widget.Apex.Pred.Section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/bh_recent" />
        <LinearLayout android:id="@+id/bhRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:divider="@drawable/divider_results" android:orientation="vertical" android:showDividers="middle" />
        <TextView android:id="@+id/bhEmpty" style="@style/Widget.Apex.Pred.Body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/bh_empty" android:visibility="gone" />
        <TextView android:id="@+id/bhRule" style="@style/Widget.Apex.Pred.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:visibility="gone" />
        <TextView style="@style/Widget.Apex.Pred.Caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/bh_source" />
    </LinearLayout>
</LinearLayout>
