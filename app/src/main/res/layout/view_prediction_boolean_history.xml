<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/bhHeading" android:text="@string/bh_title" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Apex.Pred.Title" />
    <TextView android:id="@+id/bhMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" style="@style/Widget.Apex.Pred.Body" />
    <LinearLayout android:id="@+id/bhStats" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/bhRatio" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Apex.Pred.Big" />
        <TextView android:id="@+id/bhCaption" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Apex.Pred.Caption" />
        <TextView android:id="@+id/bhUnknown" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" style="@style/Widget.Apex.Pred.Caption" />
        <TextView android:id="@+id/bhVirtual" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" style="@style/Widget.Apex.Pred.Body" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/text_color_main" android:alpha="0.12" android:layout_marginTop="16dp" android:layout_marginBottom="12dp" />
        <TextView android:text="@string/bh_recent" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Apex.Pred.Section" />
        <LinearLayout android:id="@+id/bhRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        <TextView android:id="@+id/bhEmpty" android:text="@string/bh_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:layout_marginTop="8dp" style="@style/Widget.Apex.Pred.Body" />
        <TextView android:id="@+id/bhRule" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="@style/Widget.Apex.Pred.Caption" />
        <TextView android:text="@string/bh_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" style="@style/Widget.Apex.Pred.Caption" />
    </LinearLayout>
</LinearLayout>
