<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/wd_label"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />

    <ImageView
        android:id="@+id/wd_name"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="5dp"
        android:contentDescription="@null"
        android:scaleType="fitStart" />

    <TextView
        android:id="@+id/wd_season"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text_secondary"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/wd_stats"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout style="@style/WidgetDriverMetric">
                <ImageView
                    android:id="@+id/wd_position"
                    style="@style/WidgetDriverValue" />
                <TextView
                    style="@style/WidgetDriverCaption"
                    android:text="@string/wd_position" />
            </LinearLayout>

            <LinearLayout style="@style/WidgetDriverMetric">
                <ImageView
                    android:id="@+id/wd_points"
                    style="@style/WidgetDriverValue" />
                <TextView
                    style="@style/WidgetDriverCaption"
                    android:text="@string/wd_points" />
            </LinearLayout>

            <LinearLayout style="@style/WidgetDriverMetric">
                <ImageView
                    android:id="@+id/wd_wins"
                    style="@style/WidgetDriverValue" />
                <TextView
                    style="@style/WidgetDriverCaption"
                    android:text="@string/wd_wins" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/wd_extra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout style="@style/WidgetDriverMetric">
                <ImageView
                    android:id="@+id/wd_podiums"
                    style="@style/WidgetDriverValue" />
                <TextView
                    style="@style/WidgetDriverCaption"
                    android:text="@string/wd_podiums" />
            </LinearLayout>

            <LinearLayout style="@style/WidgetDriverMetric">
                <ImageView
                    android:id="@+id/wd_poles"
                    style="@style/WidgetDriverValue" />
                <TextView
                    style="@style/WidgetDriverCaption"
                    android:text="@string/wd_poles" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wd_recent_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/wd_recent"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/wd_recent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="2"
            android:textColor="@color/widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/wd_message"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:maxLines="5"
        android:text="@string/wd_loading"
        android:textColor="@color/widget_text"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/wd_stale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/wd_stale"
        android:textColor="@color/widget_text_secondary"
        android:textSize="10sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/wd_action"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_account_button"
        android:backgroundTint="@color/hero_accent"
        android:text="@string/wd_signin"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>