<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingEnd="6dp" android:paddingStart="0dp">
            <TextView android:id="@+id/duelCodeA" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.Apex.Pred.Code" />
            <TextView android:id="@+id/duelNameA" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" style="@style/Widget.Apex.Pred.Caption" />
            <TextView android:id="@+id/duelScoreA" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="@style/Widget.Apex.Pred.Big" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:paddingStart="6dp" android:paddingEnd="0dp">
            <TextView android:id="@+id/duelCodeB" android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/Widget.Apex.Pred.Code" />
            <TextView android:id="@+id/duelNameB" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" style="@style/Widget.Apex.Pred.Caption" />
            <TextView android:id="@+id/duelScoreB" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" style="@style/Widget.Apex.Pred.Big" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/duelScoreCaption" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="@string/pred_duel_wins" style="@style/Widget.Apex.Pred.Caption" />
    <LinearLayout android:id="@+id/duelMetrics" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="16dp" android:background="@color/text_color_main" android:alpha="0.12" />
    <TextView android:id="@+id/duelRecentTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pred_duel_recent" style="@style/Widget.Apex.Pred.Section" />
    <LinearLayout android:id="@+id/duelRecentRows" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical" />
    <TextView android:id="@+id/duelResultsNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/pred_duel_finish_note" style="@style/Widget.Apex.Pred.Caption" />
</LinearLayout>
