<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/account_settings_input_color"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:cardUseCompatPadding="false">

    <ScrollView
        android:id="@+id/awardDetailsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <com.example.f1app.awardIconView
                android:id="@+id/awardDetailsIcon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal" />

            <TextView
                android:id="@+id/awardDetailsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"
                android:textColor="@color/text_color_main"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/awardDetailsIdentity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingBottom="12dp"
                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                android:textColor="@color/text_color_main"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/awardDetailsStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="16dp"
                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                android:textColor="@color/text_color_main"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/awards_details_condition"
                android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                android:textColor="@color/text_color_main"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/awardDetailsCondition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                android:textStyle="normal"
                android:textColor="@color/text_color_main"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/awardDetailsProgressSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/awardDetailsProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:indeterminate="false"
                    android:progressBackgroundTint="@color/stroke_option_color"
                    android:progressTint="@color/neuro_accent" />

                <TextView
                    android:id="@+id/awardDetailsProgressText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp"
                    android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                    android:textColor="@color/text_color_main"
                    android:textSize="13sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/awardDetailsRecorded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="10dp"
                android:paddingBottom="8dp"
                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                android:textColor="@color/grey"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/awardDetailsUse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:text="@string/displayed_award_use"
                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                android:textColor="@color/neuro_accent"
                android:textSize="14sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/awardDetailsDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="48dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:text="@string/awards_details_done"
                android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                android:textColor="@color/text_color_main"
                android:textSize="14sp" />

        </LinearLayout>

    </ScrollView>

</androidx.cardview.widget.CardView>
