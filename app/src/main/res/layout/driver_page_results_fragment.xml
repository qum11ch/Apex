<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="20dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/resHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:text="@string/driver_results"
                android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                android:textColor="@color/text_color_main"
                android:textSize="28sp"
                android:textStyle="bold" />

            <HorizontalScrollView
                android:id="@+id/seasonButtonsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/seasonButtonsLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_public_segment_track"
                    android:orientation="horizontal"
                    android:padding="4dp" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/noResultsText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/no_results_text"
                android:textColor="@color/text_color_main"
                android:textSize="16sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/summary_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_results_card"
                android:divider="@drawable/divider_results"
                android:orientation="vertical"
                android:showDividers="middle"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/summary_top"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:divider="@drawable/divider_results"
                    android:orientation="horizontal"
                    android:showDividers="middle" />

                <LinearLayout
                    android:id="@+id/summary_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:divider="@drawable/divider_results"
                    android:orientation="horizontal"
                    android:showDividers="middle" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/results_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_results_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/results_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/raceName_header"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:gravity="bottom"
                        android:text="@string/race_name_header"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                        android:textColor="@color/text_color_main"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/grid_header"
                        android:layout_width="56dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/driver_results_grid_header"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                        android:textColor="@color/text_color_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/result_header"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/result_header"
                        android:textAppearance="@style/TextStyle.Gram.Regular.Simple"
                        android:textColor="@color/text_color_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:id="@+id/line"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorPrimary" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/driver_results"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:visibility="gone" />

                    <com.facebook.shimmer.ShimmerFrameLayout
                        android:id="@+id/shimmer_layout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        app:duration="1000">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <include layout="@layout/shimmer_driver_result" />
                            <include layout="@layout/shimmer_driver_result" />
                            <include layout="@layout/shimmer_driver_result" />
                            <include layout="@layout/shimmer_driver_result" />
                            <include layout="@layout/shimmer_driver_result" />
                            <include layout="@layout/shimmer_driver_result" />
                            <include layout="@layout/shimmer_driver_result" />
                            <include layout="@layout/shimmer_driver_result" />
                        </LinearLayout>
                    </com.facebook.shimmer.ShimmerFrameLayout>
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/legend_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="1dp"
                android:layout_marginTop="24dp"
                android:text="@string/team_results_legend_title"
                android:textAppearance="@style/TextStyle.Gram.Regular.Countdown"
                android:textColor="@color/text_color_main"
                android:textSize="20sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/keyMapLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_results_card"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/legend_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical" />

                <LinearLayout
                    android:id="@+id/legend_right"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</FrameLayout>
