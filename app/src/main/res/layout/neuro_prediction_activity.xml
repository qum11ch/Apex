<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/neuro_predict_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorPrimary">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/header_color"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="14dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/back_arrow"
            android:contentDescription="@string/back_arrow" />

        <TextView
            android:id="@+id/raceTitile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="@string/neuro_design_title"
            android:textColor="@color/white"
            android:textAllCaps="true"
            android:textAppearance="@style/TextStyle.GoodTiming.Regular.ForHeader"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/aboutPrediction"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/neuro_info"
            android:contentDescription="@string/neuro_design_about"
            app:tint="@color/white" />
    </LinearLayout>
    <View
        android:layout_below="@id/header"
        android:id="@+id/separatorLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/separator_header" />
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/separatorLine"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="28dp">
            <TextView
                android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/neuro_design_heading"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="@color/text_color_secondary"
                android:textSize="12sp" />
            <TextView
                android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                android:textStyle="normal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/neuro_design_intro"
                android:textColor="@color/text_color_main"
                android:textSize="18sp"/>
            <TextView
                android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/neuro_design_stage"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="@color/text_color_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <LinearLayout
                android:id="@+id/racePickerField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="88dp"
                android:layout_marginTop="10dp"
                android:padding="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/neuro_surface"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/seasonText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/neuro_secondary"
                        android:textSize="12sp"
                        android:textAllCaps="true"
                        android:letterSpacing="0.06" />
                    <TextView
                        android:id="@+id/selectedRaceText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/neuro_design_loading"
                        android:textColor="@color/neuro_text"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/neuro_chevron"
                    android:importantForAccessibility="no" />
            </LinearLayout>
            <TextView
                android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/neuro_design_session"
                android:textAllCaps="true"
                android:letterSpacing="0.08"
                android:textColor="@color/text_color_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />
            <RadioGroup
                android:id="@+id/radioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:orientation="vertical"
                android:background="@drawable/neuro_surface">
                <androidx.appcompat.widget.AppCompatRadioButton
                    android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                    android:textStyle="normal"
                    android:id="@+id/radio1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:gravity="center_vertical"
                    android:button="@null"
                    android:background="@drawable/neuro_session_row"
                    android:drawableEnd="@drawable/neuro_check_state"
                    android:drawablePadding="12dp"
                    android:text="@string/neuro_design_qualifying"
                    android:textColor="@color/neuro_text"
                    android:textSize="16sp"
                    android:checked="true"
                    android:tag="Q" />
                <androidx.appcompat.widget.AppCompatRadioButton
                    android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                    android:textStyle="normal"
                    android:id="@+id/radio2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:gravity="center_vertical"
                    android:button="@null"
                    android:background="@drawable/neuro_session_row"
                    android:drawableEnd="@drawable/neuro_check_state"
                    android:drawablePadding="12dp"
                    android:text="@string/neuro_design_sprint"
                    android:textColor="@color/neuro_text"
                    android:textSize="16sp"
                    android:tag="SQ" />
            </RadioGroup>
            <androidx.appcompat.widget.AppCompatButton
                style="@style/ButtonStyle"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/predict_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="28dp"
                android:padding="16dp"
                app:backgroundTint="@null"
                android:enabled="false"
                android:text="@string/neuro_design_action"
                android:textAllCaps="true"
                android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader"
                android:textColor="@android:color/white"
                android:textSize="15sp"
                android:elevation="0dp" />
            <TextView
                android:textAppearance="@style/TextStyle.Gram.Regular.ForInfo"
                android:textStyle="normal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/neuro_design_note"
                android:textColor="@color/grey"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</RelativeLayout>