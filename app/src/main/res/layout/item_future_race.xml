<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        android:id="@+id/cardView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:layout_marginBottom="10dp"
            style="@style/ItemStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:weightSum="5">
            <RelativeLayout
                android:layout_weight="1.1"
                android:layout_height="match_parent"
                android:layout_width="0dp"
                android:gravity="center">
                <LinearLayout
                    android:layout_centerHorizontal="true"
                    android:id="@+id/header_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_above="@id/space">
                    <TextView
                        android:id="@+id/day_start"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textAppearance="@style/TextStyle.Audiowide.ForDays" />
                    <TextView
                        android:layout_height="match_parent"
                        android:layout_width="wrap_content"
                        android:gravity="center"
                        android:text="@string/dash"
                        android:textAppearance="@style/TextStyle.Audiowide.ForDays" />
                    <TextView
                        android:id="@+id/day_end"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textAppearance="@style/TextStyle.Audiowide.ForDays" />
                </LinearLayout>
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_centerInParent="true"
                    android:id="@+id/space"/>
                <TextView
                    android:layout_centerHorizontal="true"
                    android:backgroundTint="@color/month_color"
                    android:id="@+id/raceMonth"
                    style="@style/PtsStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/space"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="3dp"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp"
                    android:textAlignment="center"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextStyle.Audiowide.ForPTS"
                    android:textColor="@color/footer_icon" />
            </RelativeLayout>
            <RelativeLayout
                android:paddingBottom="10dp"
                android:layout_width="0dp"
                android:layout_weight="3.9"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="0dp"
                android:paddingTop="10dp">
                <LinearLayout
                    android:id="@+id/roundLayout"
                    android:layout_width="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textAllCaps="true"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="0dp"
                        android:id="@+id/round_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:text="@string/round"
                        android:paddingEnd="5dp"
                        android:paddingStart="0dp"
                        android:textColor="@color/round_color"
                        android:textSize="14sp"
                        android:textAppearance="@style/TextStyle.Audiowide.ForPTS"/>
                    <TextView
                        android:id="@+id/round"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="0dp"
                        android:paddingStart="0dp"
                        android:paddingEnd="10dp"
                        android:textAppearance="@style/TextStyle.Audiowide.ForPTS"
                        android:textColor="@color/round_color"
                        android:textSize="14sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="0dp"/>

                    <LinearLayout
                        android:id="@+id/ongoingStatusContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginEnd="10dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <View
                            android:paddingEnd="0dp"
                            android:paddingStart="2dp"
                            android:id="@+id/liveDot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="6dp"
                            android:background="@drawable/live_dot"
                            android:layout_gravity="center"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/ongoingStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAllCaps="true"
                            android:textColor="@color/white"
                            android:textAppearance="@style/TextStyle.Audiowide.ForPTS"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:visibility="gone"
                    android:id="@+id/cnd_layout"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/PtsStyle"
                    android:textColor="@color/white"
                    android:textAppearance="@style/TextStyle.Audiowide.ForPTS"
                    android:text="@string/canceled_text"
                    android:paddingStart="5dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:paddingEnd="5dp"
                    android:textAlignment="center"
                    android:backgroundTint="@color/orange" />
                <TextView
                    android:layout_marginBottom="5dp"
                    android:layout_below="@id/roundLayout"
                    android:id="@+id/raceCountry"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="0dp"
                    android:textAppearance="@style/TextStyle.GoodTiming.Bold.ForHeader" />

                <TextView
                    android:id="@+id/raceName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/raceCountry"
                    android:layout_marginEnd="8dp"
                    android:gravity="bottom"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="0dp"
                    android:textAppearance="@style/TextStyle.ShareTechCYR.ForInfo" />

                <TextView
                    android:id="@+id/circuitName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/raceName"
                    android:layout_marginEnd="8dp"
                    android:includeFontPadding="false"
                    android:lineSpacingExtra="0dp"
                    android:textAppearance="@style/TextStyle.ShareTechCYR.ForInfo" />
            </RelativeLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>